#!/usr/bin/env nus
use std/assert

# A consumer owns its entries and schemas; the package must supply everything else.
let scratch = mktemp --directory
let consumer = $scratch | path join consumer
let package = $consumer | path join dist
mkdir ($consumer | path join lib demo schemas) ($consumer | path join bin)
let config = $consumer | path join mise.toml
{
    task_config: {
        includes: [
            ($package | path join oci)
        ]
    }
    env: {
        _: {
            path: (
                # The program itself, not a shim or command wrapper that links to another,
                # such as mise's: a `nu` wrapper, which a project's `[wrappers.nu]` makes, is
                # first on PATH everywhere.
                [nus nu usage]
                | each {|tool|
                    which --all $tool
                    | where type == external
                    | where {|found| ($found.path | path expand | path parse | get stem) == $tool }
                    | first
                    | get path
                    | path dirname
                }
                | uniq
            )
        }
    }
    _: {
        nusage: {
            catalog: {
                demo: {
                    spec: {run: "open --raw lib/demo/source.kdl | print --no-newline"}
                }
            }
        }
    }
    vars: {catalog_version: "0.0.0"}
} | to toml | save $config
'name "demo"
bin "demo"
' | save ($consumer | path join lib demo source.kdl)
"# generated below\n" | save ($consumer | path join lib demo mod.nu)
{
    format: 1
    cases: [
        {
            id: ok
            output: result
            argv: [--json]
            exit_codes: [0]
        }
    ]
    outputs: [
        {
            id: result
            command: []
            name: json
            framing: json
            select: ["--json"]
            schema: result.schema.json
        }
    ]
} | to nuon | save ($consumer | path join lib demo schemas outputs.nuon)
{
    type: object
    properties: {
        ok: {type: boolean}
    }
    required: [ok]
    additionalProperties: false
} | to json | save ($consumer | path join lib demo schemas result.schema.json)
'#!/usr/bin/env nu
def main [--json, --version] {
    if $version { print "demo 1.0.0" } else { {ok: true} | to json --raw }
}
' | save ($consumer | path join bin demo)
^chmod +x ($consumer | path join bin demo)
'use std/assert
use demo *
assert equal (demo).ok true
' | save ($consumer | path join lib demo check.nu)

[
    {
        id: accepted
        output: result
        document: {ok: true}
        valid: true
    }
    {
        id: rejected
        output: result
        document: {}
        valid: false
    }
] | to nuon | save ($consumer | path join lib demo schemas examples.nuon)
mkdir ($consumer | path join extractor)
{
    package: {
        metadata: {
            clap-spec: {bin: demo, crate: demo-lib}
        }
    }
    dependencies: {demo-lib: "1.0.0"}
} | to toml | save ($consumer | path join extractor Cargo.toml)
let current = "// @generated by clap/spec.nu from the clap command of demo-lib 1.0.0\nname demo\n"
$current | save ($consumer | path join current.kdl)

# The checkout and exported tasks implement the same interfaces, including on repeat calls.
def interfaces [consumer: path, current: string] {
    let manifest = $consumer | path join lib demo schemas outputs.nuon
    let examples = $consumer | path join lib demo schemas examples.nuon
    mut overlay = ""
    for attempt in 1..2 {
        let made = ^mise run --quiet --output interleave catalog:schemas:overlay $manifest | complete
        assert equal $made.exit_code 0 $made.stderr
        assert ($made.stdout | str starts-with 'output "json"') $made.stdout
        if $attempt == 1 { $overlay = $made.stdout } else { assert equal $made.stdout $overlay }
        let checked = ^mise run --quiet --output interleave catalog:schemas:examples $manifest $examples | complete
        assert equal $checked.exit_code 0 $checked.stderr
        let captured = [
            {
                id: ok
                stdout: '{"ok":true}'
                stderr: ""
                exit_code: 0
            }
        ] | to json
        let valid = $captured | ^mise run --quiet --output interleave catalog:schemas:validate $manifest | complete
        assert equal $valid.exit_code 0 $valid.stderr
        let report = with-env {GITHUB_ACTIONS: "true"} {
            ^mise run --quiet --output interleave report:emit error "message%\nnext" --file "a,b.nu" --line 7 --title "a:b" | complete
        }
        assert equal $report.exit_code 0 $report.stderr
        assert equal $report.stdout "::error file=a%2Cb.nu,line=7,title=a%3Ab::message%25%0Anext\n"
        let annotated = with-env {GITHUB_ACTIONS: "true"} {
            ^mise run --quiet --output interleave report:emit diff "@@ -2 +2 @@\n-old\n+new\n" --file a.nu --title changed | complete
        }
        assert equal $annotated.exit_code 0 $annotated.stderr
        assert equal $annotated.stdout "::error file=a.nu,line=2,endLine=2,title=changed::-old%0A+new%0A\n"
        let clap = ^mise run --quiet --output interleave catalog:clap:spec ($consumer | path join extractor) --out ($consumer | path join current.kdl) | complete
        assert equal $clap.exit_code 0 $clap.stderr
        assert equal (open --raw ($consumer | path join current.kdl)) $current
    }
    let invalid = [
        {
            id: ok
            stdout: '{}'
            stderr: ""
            exit_code: 0
        }
    ] | to json
    let refused = $invalid | ^mise run --quiet --output interleave catalog:schemas:validate $manifest | complete
    assert ($refused.exit_code != 0) "Invalid output must fail through the task interface"
    assert ($refused.stderr | str contains ok) $refused.stderr
    let missing = '[]' | ^mise run --quiet --output interleave catalog:schemas:validate $manifest | complete
    assert ($missing.exit_code != 0) "Missing cases must fail"
    let absent = ^mise run --quiet --output interleave catalog:clap:spec ($consumer | path join missing) --out ($consumer | path join absent.kdl) | complete
    assert ($absent.exit_code != 0) "Extractor failures must reach the caller"
}

let checked = try {

    # Assemble while the producer tasks are available, before entering the consumer.
    let packed = ^mise run --quiet --output interleave //catalog:assemble --out $package | complete
    assert equal $packed.exit_code 0 $packed.stderr
    with-env {PATH: ($env.PATH | prepend ($consumer | path join bin))} {
        interfaces $consumer $current
    }
    with-env {
        MISE_CONFIG_ROOT: $consumer
        MISE_CONFIG_DIR: ($scratch | path join config)
        MISE_TRUSTED_CONFIG_PATHS: $scratch
        PATH: ($env.PATH | prepend ($consumer | path join bin))
        CI: "true"
    } {
        cd $consumer
        let listed = ^mise tasks ls --json | complete
        assert equal $listed.exit_code 0 $listed.stderr
        let names = $listed.stdout | from json | get name | sort
        assert equal $names [catalog:check catalog:clap:spec catalog:generate catalog:report:emit catalog:schemas:examples catalog:schemas:overlay catalog:schemas:validate catalog:spec]
        interfaces $consumer $current
        for task in [catalog:spec catalog:generate catalog:check] {
            let result = ^mise run $task | complete
            assert equal $result.exit_code 0 $"($task): ($result.stdout)($result.stderr)"
        }
    }
    null
} catch {|err| $err }
rm --recursive $scratch
if $checked != null {
    error make --unspanned {msg: $checked.msg}
}
print "packaged catalog: spec, schema generation and check work outside the repository"
