#!/usr/bin/env nu
# Resume per-tool releases; a release is complete only when both assets are uploaded.

def checked [gh: closure, args: list<string>] {
    let result = do $gh $args
    if $result.exit_code != 0 {
        error make {msg: $"gh ($args | str join ' '): ($result.stderr)"}
    }
    $result.stdout
}

def lookup [gh: closure, endpoint: string] {
    let result = do $gh [api $endpoint]
    if $result.exit_code == 0 {
        $result.stdout | from json
    } else if ($result.stderr | str contains "HTTP 404") {
        null
    } else {
        error make {msg: $"Reading ($endpoint): ($result.stderr)"}
    }
}

def uploaded [release: record, name: string] {
    $release.assets | any {|asset|
        $asset.name == $name and $asset.state == uploaded and $asset.size > 0
    }
}

# The gh closure returns the same record as `^gh ...$args | complete`. Inject it so
# retries can be tested without publishing releases or obtaining signing credentials.
export def prepare-packages [
    packages: list<record>
    repo: string
    source: string
    gh: closure
] {
    $packages | each {|package|
        let asset = $package.archive | path basename
        let bundle = $"packslip.catalog-($package.name).sigstore.json"
        let tag = $package.tag | url encode --all
        let release = lookup $gh $"repos/($repo)/releases/tags/($tag)"
        let has_archive = $release != null and (uploaded $release $asset)
        let has_bundle = $release != null and (uploaded $release $bundle)
        if $has_archive and $has_bundle {
            null
        } else {
            # Resolve the tag, not target_commitish: that field may name a moving branch.
            let tagged = lookup $gh $"repos/($repo)/commits/($tag)"
            let commit = $tagged.sha? | default $source
            if $release == null {
                if $commit != $source {
                    error make {msg: $"($package.tag) points at ($commit); recover the release from its original workflow revision"}
                }
                checked $gh [
                    release create $package.tag $package.archive
                    --repo $repo --target $source
                    --title $"catalog/($package.name) ($package.version)"
                    --notes $"Typed Nushell commands for ($package.name), generated by nusage: the packslip project github.com/($repo)/catalog/($package.name)."
                ] | ignore
            } else {
                if $tagged == null or $release.draft {
                    error make {msg: $"($package.tag) has no published tag; recover the release from its original workflow revision"}
                }
                if not $has_archive {
                    if $has_bundle or $commit != $source {
                        error make {msg: $"($package.tag) lacks its archive; restore the original archive or recover from its original workflow revision"}
                    }
                    # A failed upload may leave a zero-byte 'starter' asset. Only an
                    # unfinished archive from this exact revision can be replaced.
                    checked $gh [
                        release upload $package.tag $package.archive --repo $repo --clobber
                    ] | ignore
                }
            }
            $package | merge {asset: $asset, commit: $commit}
        }
    } | compact | collect
}

def main [manifest: path, --repo: string, --commit: string] {
    const catalog = path self | path dirname | path dirname
    let packages = open $manifest | update archive {|package|
        $catalog | path join $package.archive
    }
    let released = prepare-packages $packages $repo $commit {|args|
        ^gh ...$args | complete
    }
    $"released=($released | to json --raw)\n" | save --append $env.GITHUB_OUTPUT
}
