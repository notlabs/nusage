#!/usr/bin/env nusage
#USAGE about "Package the catalog for a release: the lib directory and autoload lines as a tarball, and the tasks as the directory an OCI task catalog is pushed from"
#USAGE flag "--out <dir>" default="dist" help="Where the package goes, relative to the catalog"
# The tarball is what the `nusage-catalog` tool installs: `nusage-catalog/lib/<tool>/` for
# every entry with a module, `autoload/<tool>.nu` holding the `use` line that loads it, by a
# path relative to the file, so a vendor autoload directory needs nothing else set, and an
# empty `bin/`, so that mise puts nothing of it on PATH. The OCI directory
# holds the tasks under `catalog/`, so that a consumer's `task_config.includes` names them
# `catalog:spec`, `catalog:generate`, `catalog:check` and `catalog:install`; this task and the
# module they share are not tasks there.
use catalog.nu *

let version = ^mise config get vars.catalog_version | str trim
if $version == "" {
    error make --unspanned {
        msg: "`vars.catalog_version` names the catalog's version in the mise config"
    }
}
let out = root | path join $usage.flags.out
let staged = $out | path join nusage-catalog
rm --recursive --force $staged
mkdir ($staged | path join lib) ($staged | path join autoload) ($staged | path join bin)
for entry in (entries) {
    let files = files $entry.name
    if not ($files.module | path exists) {
        error make --unspanned {
            msg: $"entry `($entry.name)`: no module at ($files.module | path relative-to (root)); `mise run generate ($entry.name)` writes it"
        }
    }
    let package = $staged | path join lib $entry.name
    cp --recursive $files.dir $package
    # What a package keeps for its maintenance stays here: a clap extractor and the fixtures
    # its suite runs in; the suite's schemas and manifest ship, as the outputs' documentation.
    for kept in [spec schema-fixtures] {
        rm --recursive --force ($package | path join $kept)
    }
    $"use ../lib/($entry.name) *\n" | save --force ($staged | path join autoload $"($entry.name).nu")
}
$"nusage catalog ($version): typed Nushell commands for other tools, generated by nusage from their usage specs. Put `lib` on `$NU_LIB_DIRS`, then `use <tool> *`; `autoload` holds a line per tool for a vendor autoload directory.\n" | save --force ($staged | path join README.md)
let tarball = $out | path join $"nusage-catalog-($version).tar.gz"
^tar --create --gzip --file $tarball --directory $out nusage-catalog
print $"($tarball | path relative-to (root))"

let oci = $out | path join oci
rm --recursive --force $oci
mkdir ($oci | path join catalog)
let tasks = root | path join tasks
for file in [catalog.nu spec.nu generate.nu check.nu install.nu] {
    cp ($tasks | path join $file) ($oci | path join catalog $file)
}
print $"($oci | path relative-to (root))/catalog: push it with `oras push <registry>/nusage-tasks:($version) catalog` from ($oci | path relative-to (root))"
