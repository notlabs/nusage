#!/usr/bin/env nusage
#USAGE about "Writes the usage spec of a binary on PATH from the clap command its crate builds"
#USAGE arg "<dir>" help="The extractor: a Cargo package whose `main` hands the command to clap-spec, and whose `package.metadata.clap-spec` names the binary and its crate"
#USAGE flag "--out <file>" required=#true help="The spec, left untouched when it already describes this version"
#USAGE flag "--force" help="Write the spec though it describes this version, after a change to the extractor or to usage"
# The extractor depends on the crate at the version of the binary on PATH; compiling it is the
# expensive part, so it runs once per version. The header names the crate and the version the
# spec was read from, and a spec whose header names them is current.
let extractor = $usage.args.dir
let manifest = $extractor | path join Cargo.toml
let package = open $manifest
let target = $package.package.metadata.clap-spec
let found = ^$target.bin --version | parse --regex '(?<version>\d+\.\d+\.\d+)'
if ($found | is-empty) {
    error make {msg: $"($target.bin) --version names no version"}
}
let version = $found.0.version
let out = $usage.flags.out
let header = $"// @generated by clap/spec.nu from the clap command of ($target.crate) ($version)\n"
if not $usage.flags.force and ($out | path exists) and (open --raw $out | str starts-with $header) {
    print $"($out) is current: ($target.bin) ($version)"
} else {
    # A dependency on the registry is moved to the version here. A fork, by git or by path, is
    # moved by hand to its tag for the version, and is only checked.
    let dependency = $package.dependencies | get $target.crate
    let fork = ($dependency | describe) starts-with record and ([git path] | any {|key| $key in ($dependency | columns) })
    if not $fork {
        ^cargo add --quiet --manifest-path $manifest $"($target.crate)@=($version)"
    }
    let resolved = ^cargo tree --quiet --manifest-path $manifest --package $target.crate --depth 0
    | parse --regex ' v(?<version>\S+)'
    if $resolved.0?.version? != $version {
        error make {
            msg: $"the extractor builds ($target.crate) ($resolved.0?.version?), and PATH has ($target.bin) ($version)"
        }
    }
    let spec = ^cargo run --quiet --locked --manifest-path $manifest -- $target.bin $version
    $header + ($spec | str trim --right) + "\n" | save --force $out
    print $"($out): ($target.bin) ($version), from ($target.crate)"
}
