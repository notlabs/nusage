// Typed history commands own their JSON lines. Diff modes append text to them, and
// log --count replaces them; their formatting options belong to the original CLI, ^jj.
cmd "log" {
    flag "-p --patch" hide=#true
    flag "-s --summary" hide=#true
    flag --stat hide=#true
    flag --types hide=#true
    flag --name-only hide=#true
    flag --git hide=#true
    flag --color-words hide=#true
    flag --tool hide=#true
    flag --context hide=#true
    flag --ignore-all-space hide=#true
    flag --ignore-space-change hide=#true
    flag --count hide=#true
}
cmd "evolog" {
    flag "-p --patch" hide=#true
    flag "-s --summary" hide=#true
    flag --stat hide=#true
    flag --types hide=#true
    flag --name-only hide=#true
    flag --git hide=#true
    flag --color-words hide=#true
    flag --tool hide=#true
    flag --context hide=#true
    flag --ignore-all-space hide=#true
    flag --ignore-space-change hide=#true
}
cmd "operation" {
    cmd "log" {
        flag "-p --patch" hide=#true
        flag "-s --summary" hide=#true
        flag --stat hide=#true
        flag --types hide=#true
        flag --name-only hide=#true
        flag --git hide=#true
        flag --color-words hide=#true
        flag --tool hide=#true
        flag --context hide=#true
        flag --ignore-all-space hide=#true
        flag --ignore-space-change hide=#true
        flag "-d --op-diff" hide=#true
        flag --show-changes-in hide=#true
    }
}
