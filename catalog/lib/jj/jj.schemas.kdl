cmd "log" { output "json" framing="jsonl" { nusage-args "--no-graph" "--template" "json(self) ++ \"\\n\""; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"A commit, one line of `jj log`\",\n  \"$ref\": \"#/$defs/commit\",\n  \"$defs\": {\n    \"commit_id\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[0-9a-f]+$\"\n    },\n    \"signature\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"name\",\n        \"email\",\n        \"timestamp\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"email\": {\n          \"type\": \"string\"\n        },\n        \"timestamp\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        }\n      }\n    },\n    \"commit\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"commit_id\",\n        \"parents\",\n        \"change_id\",\n        \"description\",\n        \"author\",\n        \"committer\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"commit_id\": {\n          \"$ref\": \"#/$defs/commit_id\"\n        },\n        \"parents\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/$defs/commit_id\"\n          }\n        },\n        \"change_id\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[k-z]+$\"\n        },\n        \"description\": {\n          \"type\": \"string\"\n        },\n        \"author\": {\n          \"$ref\": \"#/$defs/signature\"\n        },\n        \"committer\": {\n          \"$ref\": \"#/$defs/signature\"\n        }\n      }\n    }\n  }\n}\n" } }
cmd "evolog" { output "json" framing="jsonl" { nusage-args "--no-graph" "--template" "json(self) ++ \"\\n\""; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"An entry of `jj evolog`: the commit, and the operation that wrote it, if recorded\",\n  \"type\": \"object\",\n  \"required\": [\n    \"commit\",\n    \"operation\"\n  ],\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"commit\": {\n      \"$ref\": \"#/$defs/commit\"\n    },\n    \"operation\": {\n      \"anyOf\": [\n        {\n          \"$ref\": \"#/$defs/operation\"\n        },\n        {\n          \"type\": \"null\"\n        }\n      ]\n    }\n  },\n  \"$defs\": {\n    \"commit_id\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[0-9a-f]+$\"\n    },\n    \"signature\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"name\",\n        \"email\",\n        \"timestamp\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"email\": {\n          \"type\": \"string\"\n        },\n        \"timestamp\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        }\n      }\n    },\n    \"commit\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"commit_id\",\n        \"parents\",\n        \"change_id\",\n        \"description\",\n        \"author\",\n        \"committer\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"commit_id\": {\n          \"$ref\": \"#/$defs/commit_id\"\n        },\n        \"parents\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/$defs/commit_id\"\n          }\n        },\n        \"change_id\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[k-z]+$\"\n        },\n        \"description\": {\n          \"type\": \"string\"\n        },\n        \"author\": {\n          \"$ref\": \"#/$defs/signature\"\n        },\n        \"committer\": {\n          \"$ref\": \"#/$defs/signature\"\n        }\n      }\n    },\n    \"operation\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"id\",\n        \"parents\",\n        \"time\",\n        \"description\",\n        \"hostname\",\n        \"username\",\n        \"is_snapshot\",\n        \"workspace_name\",\n        \"attributes\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[0-9a-f]+$\"\n        },\n        \"parents\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\",\n            \"pattern\": \"^[0-9a-f]+$\"\n          }\n        },\n        \"time\": {\n          \"type\": \"object\",\n          \"required\": [\n            \"start\",\n            \"end\"\n          ],\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"start\": {\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n            },\n            \"end\": {\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n            }\n          }\n        },\n        \"description\": {\n          \"type\": \"string\"\n        },\n        \"hostname\": {\n          \"type\": \"string\"\n        },\n        \"username\": {\n          \"type\": \"string\"\n        },\n        \"is_snapshot\": {\n          \"type\": \"boolean\"\n        },\n        \"workspace_name\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"attributes\": {\n          \"type\": \"object\",\n          \"additionalProperties\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}\n" } }
cmd "operation" { cmd "log" { output "json" framing="jsonl" { nusage-args "--no-graph" "--template" "json(self) ++ \"\\n\""; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"An operation, one line of `jj operation log`\",\n  \"type\": \"object\",\n  \"required\": [\n    \"id\",\n    \"parents\",\n    \"time\",\n    \"description\",\n    \"hostname\",\n    \"username\",\n    \"is_snapshot\",\n    \"workspace_name\",\n    \"attributes\"\n  ],\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"id\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[0-9a-f]+$\"\n    },\n    \"parents\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"pattern\": \"^[0-9a-f]+$\"\n      }\n    },\n    \"time\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"start\",\n        \"end\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"start\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"end\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        }\n      }\n    },\n    \"description\": {\n      \"type\": \"string\"\n    },\n    \"hostname\": {\n      \"type\": \"string\"\n    },\n    \"username\": {\n      \"type\": \"string\"\n    },\n    \"is_snapshot\": {\n      \"type\": \"boolean\"\n    },\n    \"workspace_name\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"attributes\": {\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\"\n      }\n    }\n  }\n}\n" } } }
cmd "bookmark" { cmd "list" { output "json" framing="jsonl" { nusage-args "--template" "json(self) ++ \"\\n\""; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"A bookmark or a tag, one line of `jj bookmark list` or `jj tag list`\",\n  \"type\": \"object\",\n  \"required\": [\n    \"name\",\n    \"target\"\n  ],\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"name\": {\n      \"type\": \"string\"\n    },\n    \"remote\": {\n      \"type\": \"string\"\n    },\n    \"target\": {\n      \"$ref\": \"#/$defs/target\"\n    },\n    \"tracking_target\": {\n      \"$ref\": \"#/$defs/target\"\n    }\n  },\n  \"$defs\": {\n    \"target\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\n        \"anyOf\": [\n          {\n            \"type\": \"string\",\n            \"pattern\": \"^[0-9a-f]+$\"\n          },\n          {\n            \"type\": \"null\"\n          }\n        ]\n      }\n    }\n  }\n}\n" } } }
cmd "tag" { cmd "list" { output "json" framing="jsonl" { nusage-args "--template" "json(self) ++ \"\\n\""; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"A bookmark or a tag, one line of `jj bookmark list` or `jj tag list`\",\n  \"type\": \"object\",\n  \"required\": [\n    \"name\",\n    \"target\"\n  ],\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"name\": {\n      \"type\": \"string\"\n    },\n    \"remote\": {\n      \"type\": \"string\"\n    },\n    \"target\": {\n      \"$ref\": \"#/$defs/target\"\n    },\n    \"tracking_target\": {\n      \"$ref\": \"#/$defs/target\"\n    }\n  },\n  \"$defs\": {\n    \"target\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"items\": {\n        \"anyOf\": [\n          {\n            \"type\": \"string\",\n            \"pattern\": \"^[0-9a-f]+$\"\n          },\n          {\n            \"type\": \"null\"\n          }\n        ]\n      }\n    }\n  }\n}\n" } } }
cmd "workspace" { cmd "list" { output "json" framing="jsonl" { nusage-args "--template" "json(self) ++ \"\\n\""; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"A workspace and its working-copy commit, one line of `jj workspace list`\",\n  \"type\": \"object\",\n  \"required\": [\n    \"name\",\n    \"target\"\n  ],\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"name\": {\n      \"type\": \"string\"\n    },\n    \"target\": {\n      \"$ref\": \"#/$defs/commit\"\n    }\n  },\n  \"$defs\": {\n    \"commit_id\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[0-9a-f]+$\"\n    },\n    \"signature\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"name\",\n        \"email\",\n        \"timestamp\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"email\": {\n          \"type\": \"string\"\n        },\n        \"timestamp\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        }\n      }\n    },\n    \"commit\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"commit_id\",\n        \"parents\",\n        \"change_id\",\n        \"description\",\n        \"author\",\n        \"committer\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"commit_id\": {\n          \"$ref\": \"#/$defs/commit_id\"\n        },\n        \"parents\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/$defs/commit_id\"\n          }\n        },\n        \"change_id\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[k-z]+$\"\n        },\n        \"description\": {\n          \"type\": \"string\"\n        },\n        \"author\": {\n          \"$ref\": \"#/$defs/signature\"\n        },\n        \"committer\": {\n          \"$ref\": \"#/$defs/signature\"\n        }\n      }\n    }\n  }\n}\n" } } }
cmd "config" { cmd "list" { output "json" framing="jsonl" { nusage-args "--template" "json(self) ++ \"\\n\""; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"A configuration value, one line of `jj config list`\",\n  \"type\": \"object\",\n  \"required\": [\n    \"name\",\n    \"value\",\n    \"source\",\n    \"path\",\n    \"is_overridden\"\n  ],\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"name\": {\n      \"type\": \"string\"\n    },\n    \"value\": {\n      \"description\": \"Any TOML value; a TOML datetime is {\\\"$__toml_private_datetime\\\": \\\"...\\\"}\"\n    },\n    \"source\": {\n      \"enum\": [\n        \"default\",\n        \"system\",\n        \"env\",\n        \"user\",\n        \"repo\",\n        \"workspace\",\n        \"cli\"\n      ]\n    },\n    \"path\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"is_overridden\": {\n      \"type\": \"boolean\"\n    }\n  }\n}\n" } } }