{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A configuration value, one line of `jj config list`",
  "type": "object",
  "required": [
    "name",
    "value",
    "source",
    "path",
    "is_overridden"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "value": {
      "description": "Any TOML value; a TOML datetime is {\"$__toml_private_datetime\": \"...\"}"
    },
    "source": {
      "enum": [
        "default",
        "system",
        "env",
        "user",
        "repo",
        "workspace",
        "cli"
      ]
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_overridden": {
      "type": "boolean"
    }
  }
}
