{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A bookmark or a tag, one line of `jj bookmark list` or `jj tag list`",
  "type": "object",
  "required": [
    "name",
    "target"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "remote": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "tracking_target": {
      "$ref": "#/$defs/target"
    }
  },
  "$defs": {
    "target": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[0-9a-f]+$"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
