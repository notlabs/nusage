cmd "ls-remote" { output "json" framing="json" select="--json" { schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"mise ls-remote --json\",\n  \"$comment\": \"The --all mode omits release_url/rolling/checksum and always includes nullable prerelease. anyOf allows an empty list in either mode.\",\n  \"$defs\": {\n    \"single\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"version\": {\n          \"type\": \"string\"\n        },\n        \"created_at\": {\n          \"type\": \"string\"\n        },\n        \"release_url\": {\n          \"type\": \"string\"\n        },\n        \"rolling\": {\n          \"const\": true\n        },\n        \"checksum\": {\n          \"type\": \"string\"\n        },\n        \"prerelease\": {\n          \"type\": \"boolean\"\n        }\n      },\n      \"required\": [\n        \"version\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"all\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"tool\": {\n          \"type\": \"string\"\n        },\n        \"version\": {\n          \"type\": \"string\"\n        },\n        \"created_at\": {\n          \"type\": \"string\"\n        },\n        \"prerelease\": {\n          \"type\": [\n            \"boolean\",\n            \"null\"\n          ]\n        }\n      },\n      \"required\": [\n        \"tool\",\n        \"version\",\n        \"prerelease\"\n      ],\n      \"additionalProperties\": false\n    }\n  },\n  \"anyOf\": [\n    {\n      \"type\": \"array\",\n      \"items\": {\n        \"$ref\": \"#/$defs/single\"\n      }\n    },\n    {\n      \"type\": \"array\",\n      \"items\": {\n        \"$ref\": \"#/$defs/all\"\n      }\n    }\n  ]\n}\n" } }
