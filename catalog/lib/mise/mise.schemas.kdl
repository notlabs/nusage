        ]\n            }\n          },\n          \"required\": [\n            \"type\"\n          ],\n          \"additionalProperties\": false\n        }\n      ]\n    },\n    \"tool\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"short\": {\n          \"type\": \"string\"\n        },\n        \"backends\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"bins\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"minItems\": 1\n        },\n        \"description\": {\n          \"type\": \"string\"\n        },\n        \"url\": {\n          \"type\": \"string\"\n        },\n        \"aliases\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          },\n          \"minItems\": 1\n        },\n        \"security\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/$defs/security\"\n          },\n          \"minItems\": 1\n        }\n      },\n      \"required\": [\n        \"short\",\n        \"backends\"\n      ],\n      \"additionalProperties\": false\n    }\n  },\n  \"oneOf\": [\n    {\n      \"$ref\": \"#/$defs/tool\"\n    },\n    {\n      \"type\": \"array\",\n      \"items\": {\n        \"$ref\": \"#/$defs/tool\"\n      }\n    }\n  ]\n}\n" } }
