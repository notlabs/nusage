{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mise installs ls --json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "dir": {
        "type": "string"
      },
      "backend": {
        "type": "string"
      },
      "version": {
        "type": "string"
      },
      "platform": {
        "type": "string"
      },
      "mode": {
        "enum": [
          "fallback",
          "resolved"
        ]
      },
      "options": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "requested_as": {
        "type": [
          "string",
          "null"
        ]
      },
      "checksum": {
        "type": [
          "string",
          "null"
        ]
      },
      "pinned": {
        "type": "boolean"
      },
      "selected": {
        "type": "boolean"
      },
      "shared": {
        "type": "boolean"
      }
    },
    "required": [
      "name",
      "dir",
      "backend",
      "version",
      "platform",
      "mode",
      "options",
      "requested_as",
      "checksum",
      "pinned",
      "selected",
      "shared"
    ],
    "additionalProperties": false
  }
}
