{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mise tool --json (without a field filter)",
  "$defs": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                ".tool-versions",
                "mise.toml",
                "mise.toml-daemon",
                "idiomatic-version-file",
                "tool-stub"
              ]
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "argument",
                "unknown"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "environment"
            },
            "key": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "key",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "security": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "checksum"
            },
            "algorithm": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "github_attestations"
            },
            "signer_workflow": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "slsa"
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "minisign"
            },
            "public_key": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "cosign",
                "packslip",
                "gpg"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "backend": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "installed_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_versions": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "active_versions": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "config_source": {
      "oneOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "null"
        }
      ]
    },
    "tool_options": {
      "type": "object",
      "properties": {
        "os": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "depends": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "install_env": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "lazy": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "lazy_bins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auto_update": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "os",
        "depends",
        "install_env",
        "lazy",
        "lazy_bins",
        "auto_update"
      ],
      "additionalProperties": true,
      "$comment": "Backend-specific flattened options are arbitrary TOML values; the core fields are always serialized."
    },
    "security": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/security"
      }
    }
  },
  "required": [
    "backend",
    "description",
    "url",
    "installed_versions",
    "requested_versions",
    "active_versions",
    "config_source",
    "tool_options",
    "security"
  ],
  "additionalProperties": false
}
