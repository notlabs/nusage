{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mise doctor project --json",
  "type": "object",
  "properties": {
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "error",
              "skipped",
              "blocked"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "description",
          "source",
          "status",
          "message",
          "hint"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "errors",
    "checks"
  ],
  "additionalProperties": false
}
