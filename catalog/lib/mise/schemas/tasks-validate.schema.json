{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mise tasks validate --json",
  "type": "object",
  "properties": {
    "tasks_validated": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "category": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "task",
          "severity",
          "category",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tasks_validated",
    "errors",
    "warnings",
    "issues"
  ],
  "additionalProperties": false
}
