{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A workflow run, as `gh run view --json` selects its fields",
  "$ref": "#/$defs/run",
  "$defs": {
    "run": {
      "type": "object",
      "required": [
        "databaseId",
        "number",
        "attempt",
        "name",
        "displayTitle",
        "workflowName",
        "headBranch",
        "headSha",
        "event",
        "status",
        "conclusion",
        "createdAt",
        "updatedAt",
        "startedAt",
        "url",
        "jobs"
      ],
      "additionalProperties": false,
      "properties": {
        "databaseId": {
          "type": "integer"
        },
        "number": {
          "type": "integer"
        },
        "attempt": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "displayTitle": {
          "type": "string"
        },
        "workflowName": {
          "type": "string"
        },
        "headBranch": {
          "type": "string"
        },
        "headSha": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": "string"
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/job"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "name",
        "status",
        "conclusion",
        "number",
        "startedAt",
        "completedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        },
        "number": {
          "type": "integer"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "job": {
      "type": "object",
      "required": [
        "databaseId",
        "name",
        "status",
        "conclusion",
        "startedAt",
        "completedAt",
        "url",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "databaseId": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    }
  }
}
