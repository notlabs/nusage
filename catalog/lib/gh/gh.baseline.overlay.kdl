// The baseline: the groups an agent or a script reaches for, `pr`, `issue`, `repo`, `run`
// and `release`, with their list and view commands typed by `schemas/outputs.nuon`. The
// others stay in the spec, `gh.usage.kdl`, and in the original CLI, `^gh`: `api` returns
// whatever the endpoint does, and the rest wait for their outputs to be declared.
cmd "agent-task" hide=#true
cmd "alias" hide=#true
cmd "api" hide=#true
cmd "attestation" hide=#true
cmd "auth" hide=#true
cmd "browse" hide=#true
cmd "cache" hide=#true
cmd "codespace" hide=#true
cmd "completion" hide=#true
cmd "config" hide=#true
cmd "copilot" hide=#true
cmd "discussion" hide=#true
cmd "extension" hide=#true
cmd "gist" hide=#true
cmd "gpg-key" hide=#true
cmd "label" hide=#true
cmd "licenses" hide=#true
cmd "org" hide=#true
cmd "preview" hide=#true
cmd "project" hide=#true
cmd "ruleset" hide=#true
cmd "search" hide=#true
cmd "secret" hide=#true
cmd "skill" hide=#true
cmd "ssh-key" hide=#true
cmd "status" hide=#true
cmd "variable" hide=#true
cmd "workflow" hide=#true
// `verify [<tag>] <asset>`: an optional positional before a required one, which no Nushell
// signature can say; `^gh release verify` is still there.
cmd "release" {
    cmd "verify" hide=#true
    cmd "verify-asset" hide=#true
}
