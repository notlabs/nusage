tusCheckRollup\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"number\": {\n          \"type\": \"integer\"\n        },\n        \"title\": {\n          \"type\": \"string\"\n        },\n        \"state\": {\n          \"enum\": [\n            \"OPEN\",\n            \"CLOSED\",\n            \"MERGED\"\n          ]\n        },\n        \"isDraft\": {\n          \"type\": \"boolean\"\n        },\n        \"url\": {\n          \"type\": \"string\"\n        },\n        \"author\": {\n          \"$ref\": \"#/$defs/author\"\n        },\n        \"headRefName\": {\n          \"type\": \"string\"\n        },\n        \"baseRefName\": {\n          \"type\": \"string\"\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"updatedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"closedAt\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ]\n        },\n        \"mergedAt\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ]\n        },\n        \"labels\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/$defs/label\"\n          }\n        },\n        \"reviewDecision\": {\n          \"enum\": [\n            \"\",\n            \"APPROVED\",\n            \"CHANGES_REQUESTED\",\n            \"REVIEW_REQUIRED\"\n          ]\n        },\n        \"body\": {\n          \"type\": \"string\"\n        },\n        \"headRefOid\": {\n          \"type\": \"string\"\n        },\n        \"isCrossRepository\": {\n          \"type\": \"boolean\"\n        },\n        \"mergeable\": {\n          \"enum\": [\n            \"MERGEABLE\",\n            \"CONFLICTING\",\n            \"UNKNOWN\"\n          ]\n        },\n        \"mergeStateStatus\": {\n          \"type\": \"string\"\n        },\n        \"statusCheckRollup\": {\n          \"anyOf\": [\n            {\n              \"type\": \"array\",\n              \"items\": {\n                \"anyOf\": [\n                  {\n                    \"$ref\": \"#/$defs/check_run\"\n                  },\n                  {\n                    \"$ref\": \"#/$defs/status_context\"\n                  }\n                ]\n              }\n            },\n            {\n              \"type\": \"null\"\n            }\n          ]\n        }\n      }\n    },\n    \"check_run\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"__typename\",\n        \"name\",\n        \"workflowName\",\n        \"status\",\n        \"conclusion\",\n        \"startedAt\",\n        \"completedAt\",\n        \"detailsUrl\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"__typename\": {\n          \"const\": \"CheckRun\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"workflowName\": {\n          \"type\": \"string\"\n        },\n        \"status\": {\n          \"type\": \"string\"\n        },\n        \"conclusion\": {\n          \"type\": \"string\"\n        },\n        \"startedAt\": {\n          \"type\": \"string\"\n        },\n        \"completedAt\": {\n          \"type\": \"string\"\n        },\n        \"detailsUrl\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"status_context\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"__typename\",\n        \"context\",\n        \"state\",\n        \"targetUrl\",\n        \"startedAt\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"__typename\": {\n          \"const\": \"StatusContext\"\n        },\n        \"context\": {\n          \"type\": \"string\"\n        },\n        \"state\": {\n          \"type\": \"string\"\n        },\n        \"targetUrl\": {\n          \"type\": \"string\"\n        },\n        \"startedAt\": {\n          \"type\": \"string\"\n        }\n      }\n    }\n  }\n}\n" } } }
cmd "pr" { cmd "checks" { output "json" framing="json" { nusage-args "--json" "name,state,startedAt,completedAt,link,bucket,event,workflow,description"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"The checks of a pull request, as `gh pr checks --json` selects their fields, one array\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"required\": [\n      \"name\",\n      \"state\",\n      \"startedAt\",\n      \"completedAt\",\n      \"link\",\n      \"bucket\",\n      \"event\",\n      \"workflow\",\n      \"description\"\n    ],\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"name\": {\"type\": \"string\"},\n      \"state\": {\"type\": \"string\"},\n      \"startedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n      \"completedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n      \"link\": {\"type\": \"string\"},\n      \"bucket\": {\"enum\": [\"pass\", \"fail\", \"pending\", \"skipping\", \"cancel\"]},\n      \"event\": {\"type\": \"string\"},\n      \"workflow\": {\"type\": \"string\"},\n      \"description\": {\"type\": \"string\"}\n    }\n  }\n}\n" } } }
cmd "issue" { cmd "list" { output "json" framing="json" { nusage-args "--json" "number,title,state,stateReason,url,author,createdAt,updatedAt,closedAt,labels,assignees,body"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"The issues `gh issue list --json` selects, one array\",\n  \"type\": \"array\",\n  \"items\": {\"$ref\": \"#/$defs/issue\"},\n  \"$defs\": {\n    \"author\": {\n      \"type\": \"object\",\n      \"required\": [\"is_bot\", \"login\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"is_bot\": {\"type\": \"boolean\"},\n        \"login\": {\"type\": \"string\"},\n        \"id\": {\"type\": \"string\"},\n        \"name\": {\"type\": \"string\"}\n      }\n    },\n    \"label\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"name\", \"description\", \"color\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\"type\": \"string\"},\n        \"name\": {\"type\": \"string\"},\n        \"description\": {\"type\": \"string\"},\n        \"color\": {\"type\": \"string\"}\n      }\n    },\n    \"user\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"login\", \"name\", \"databaseId\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\"type\": \"string\"},\n        \"login\": {\"type\": \"string\"},\n        \"name\": {\"type\": \"string\"},\n        \"databaseId\": {\"type\": \"integer\"}\n      }\n    },\n    \"issue\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"number\",\n        \"title\",\n        \"state\",\n        \"stateReason\",\n        \"url\",\n        \"author\",\n        \"createdAt\",\n        \"updatedAt\",\n        \"closedAt\",\n        \"labels\",\n        \"assignees\",\n        \"body\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"number\": {\"type\": \"integer\"},\n        \"title\": {\"type\": \"string\"},\n        \"state\": {\"enum\": [\"OPEN\", \"CLOSED\"]},\n        \"stateReason\": {\"type\": \"string\"},\n        \"url\": {\"type\": \"string\"},\n        \"author\": {\"$ref\": \"#/$defs/author\"},\n        \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"updatedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"closedAt\": {\"anyOf\": [{\"type\": \"string\", \"format\": \"date-time\"}, {\"type\": \"null\"}]},\n        \"labels\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/label\"}},\n        \"assignees\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/user\"}},\n        \"body\": {\"type\": \"string\"}\n      }\n    }\n  }\n}\n" } } }
