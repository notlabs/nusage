cmd "release" { cmd "list" { output "json" framing="json" { nusage-args "--json" "name,tagName,isDraft,isLatest,isPrerelease,isImmutable,createdAt,publishedAt"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"The releases `gh release list --json` selects, one array\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"required\": [\n      \"name\",\n      \"tagName\",\n      \"isDraft\",\n      \"isLatest\",\n      \"isPrerelease\",\n      \"isImmutable\",\n      \"createdAt\",\n      \"publishedAt\"\n    ],\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"name\": {\"type\": \"string\"},\n      \"tagName\": {\"type\": \"string\"},\n      \"isDraft\": {\"type\": \"boolean\"},\n      \"isLatest\": {\"type\": \"boolean\"},\n      \"isPrerelease\": {\"type\": \"boolean\"},\n      \"isImmutable\": {\"type\": \"boolean\"},\n      \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n      \"publishedAt\": {\"type\": \"string\", \"format\": \"date-time\"}\n    }\n  }\n}\n" } } }
cmd "release" { cmd "view" { output "json" framing="json" { nusage-args "--json" "tagName,name,body,isDraft,isPrerelease,isImmutable,createdAt,publishedAt,targetCommitish,url,author,assets"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"A release with its assets, as `gh release view --json` selects its fields\",\n  \"type\": \"object\",\n  \"required\": [\n    \"tagName\",\n    \"name\",\n    \"body\",\n    \"isDraft\",\n    \"isPrerelease\",\n    \"isImmutable\",\n    \"createdAt\",\n    \"publishedAt\",\n    \"targetCommitish\",\n    \"url\",\n    \"author\",\n    \"assets\"\n  ],\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"tagName\": {\"type\": \"string\"},\n    \"name\": {\"type\": \"string\"},\n    \"body\": {\"type\": \"string\"},\n    \"isDraft\": {\"type\": \"boolean\"},\n    \"isPrerelease\": {\"type\": \"boolean\"},\n    \"isImmutable\": {\"type\": \"boolean\"},\n    \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n    \"publishedAt\": {\"anyOf\": [{\"type\": \"string\", \"format\": \"date-time\"}, {\"type\": \"null\"}]},\n    \"targetCommitish\": {\"type\": \"string\"},\n    \"url\": {\"type\": \"string\"},\n    \"author\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"login\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\"type\": \"string\"},\n        \"login\": {\"type\": \"string\"}\n      }\n    },\n    \"assets\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"url\",\n          \"apiUrl\",\n          \"id\",\n          \"name\",\n          \"label\",\n          \"size\",\n          \"digest\",\n          \"state\",\n          \"createdAt\",\n          \"updatedAt\",\n          \"downloadCount\",\n          \"contentType\"\n        ],\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"url\": {\"type\": \"string\"},\n          \"apiUrl\": {\"type\": \"string\"},\n          \"id\": {\"type\": \"string\"},\n          \"name\": {\"type\": \"string\"},\n          \"label\": {\"type\": \"string\"},\n          \"size\": {\"type\": \"integer\"},\n          \"digest\": {\"type\": [\"string\", \"null\"]},\n          \"state\": {\"type\": \"string\"},\n          \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n          \"updatedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n          \"downloadCount\": {\"type\": \"integer\"},\n          \"contentType\": {\"type\": \"string\"}\n        }\n      }\n    }\n  }\n}\n" } } }