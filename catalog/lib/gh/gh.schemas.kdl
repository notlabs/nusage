cmd "pr" { cmd "list" { output "json" framing="json" { nusage-args "--json" "number,title,state,isDraft,url,author,headRefName,baseRefName,createdAt,updatedAt,closedAt,mergedAt,labels,reviewDecision,body"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"The pull requests `gh pr list --json` selects, one array\",\n  \"type\": \"array\",\n  \"items\": {\"$ref\": \"#/$defs/pull_request\"},\n  \"$defs\": {\n    \"author\": {\n      \"type\": \"object\",\n      \"required\": [\"is_bot\", \"login\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"is_bot\": {\"type\": \"boolean\"},\n        \"login\": {\"type\": \"string\"},\n        \"id\": {\"type\": \"string\"},\n        \"name\": {\"type\": \"string\"}\n      }\n    },\n    \"label\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"name\", \"description\", \"color\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\"type\": \"string\"},\n        \"name\": {\"type\": \"string\"},\n        \"description\": {\"type\": \"string\"},\n        \"color\": {\"type\": \"string\"}\n      }\n    },\n    \"pull_request\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"number\",\n        \"title\",\n        \"state\",\n        \"isDraft\",\n        \"url\",\n        \"author\",\n        \"headRefName\",\n        \"baseRefName\",\n        \"createdAt\",\n        \"updatedAt\",\n        \"closedAt\",\n        \"mergedAt\",\n        \"labels\",\n        \"reviewDecision\",\n        \"body\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"number\": {\"type\": \"integer\"},\n        \"title\": {\"type\": \"string\"},\n        \"state\": {\"enum\": [\"OPEN\", \"CLOSED\", \"MERGED\"]},\n        \"isDraft\": {\"type\": \"boolean\"},\n        \"url\": {\"type\": \"string\"},\n        \"author\": {\"$ref\": \"#/$defs/author\"},\n        \"headRefName\": {\"type\": \"string\"},\n        \"baseRefName\": {\"type\": \"string\"},\n        \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"updatedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"closedAt\": {\"anyOf\": [{\"type\": \"string\", \"format\": \"date-time\"}, {\"type\": \"null\"}]},\n        \"mergedAt\": {\"anyOf\": [{\"type\": \"string\", \"format\": \"date-time\"}, {\"type\": \"null\"}]},\n        \"labels\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/label\"}},\n        \"reviewDecision\": {\"enum\": [\"\", \"APPROVED\", \"CHANGES_REQUESTED\", \"REVIEW_REQUIRED\"]},\n        \"body\": {\"type\": \"string\"}\n      }\n    }\n  }\n}\n" } } }
cmd "pr" { cmd "view" { output "json" framing="json" { nusage-args "--json" "number,title,state,isDraft,url,author,headRefName,baseRefName,createdAt,updatedAt,closedAt,mergedAt,labels,reviewDecision,body"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"A pull request, as `gh pr view --json` selects its fields\",\n  \"$ref\": \"#/$defs/pull_request\",\n  \"$defs\": {\n    \"author\": {\n      \"type\": \"object\",\n      \"required\": [\"is_bot\", \"login\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"is_bot\": {\"type\": \"boolean\"},\n        \"login\": {\"type\": \"string\"},\n        \"id\": {\"type\": \"string\"},\n        \"name\": {\"type\": \"string\"}\n      }\n    },\n    \"label\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"name\", \"description\", \"color\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\"type\": \"string\"},\n        \"name\": {\"type\": \"string\"},\n        \"description\": {\"type\": \"string\"},\n        \"color\": {\"type\": \"string\"}\n      }\n    },\n    \"pull_request\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"number\",\n        \"title\",\n        \"state\",\n        \"isDraft\",\n        \"url\",\n        \"author\",\n        \"headRefName\",\n        \"baseRefName\",\n        \"createdAt\",\n        \"updatedAt\",\n        \"closedAt\",\n        \"mergedAt\",\n        \"labels\",\n        \"reviewDecision\",\n        \"body\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"number\": {\"type\": \"integer\"},\n        \"title\": {\"type\": \"string\"},\n        \"state\": {\"enum\": [\"OPEN\", \"CLOSED\", \"MERGED\"]},\n        \"isDraft\": {\"type\": \"boolean\"},\n        \"url\": {\"type\": \"string\"},\n        \"author\": {\"$ref\": \"#/$defs/author\"},\n        \"headRefName\": {\"type\": \"string\"},\n        \"baseRefName\": {\"type\": \"string\"},\n        \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"updatedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"closedAt\": {\"anyOf\": [{\"type\": \"string\", \"format\": \"date-time\"}, {\"type\": \"null\"}]},\n        \"mergedAt\": {\"anyOf\": [{\"type\": \"string\", \"format\": \"date-time\"}, {\"type\": \"null\"}]},\n        \"labels\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/label\"}},\n        \"reviewDecision\": {\"enum\": [\"\", \"APPROVED\", \"CHANGES_REQUESTED\", \"REVIEW_REQUIRED\"]},\n        \"body\": {\"type\": \"string\"}\n      }\n    }\n  }\n}\n" } } }
cmd "pr" { cmd "checks" { output "json" framing="json" { nusage-args "--json" "name,state,startedAt,completedAt,link,bucket,event,workflow,description"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"The checks of a pull request, as `gh pr checks --json` selects their fields, one array\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"required\": [\n      \"name\",\n      \"state\",\n      \"startedAt\",\n      \"completedAt\",\n      \"link\",\n      \"bucket\",\n      \"event\",\n      \"workflow\",\n      \"description\"\n    ],\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"name\": {\"type\": \"string\"},\n      \"state\": {\"type\": \"string\"},\n      \"startedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n      \"completedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n      \"link\": {\"type\": \"string\"},\n      \"bucket\": {\"enum\": [\"pass\", \"fail\", \"pending\", \"skipping\", \"cancel\"]},\n      \"event\": {\"type\": \"string\"},\n      \"workflow\": {\"type\": \"string\"},\n      \"description\": {\"type\": \"string\"}\n    }\n  }\n}\n" } } }
cmd "issue" { cmd "list" { output "json" framing="json" { nusage-args "--json" "number,title,state,stateReason,url,author,createdAt,updatedAt,closedAt,labels,assignees,body"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"The issues `gh issue list --json` selects, one array\",\n  \"type\": \"array\",\n  \"items\": {\"$ref\": \"#/$defs/issue\"},\n  \"$defs\": {\n    \"author\": {\n      \"type\": \"object\",\n      \"required\": [\"is_bot\", \"login\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"is_bot\": {\"type\": \"boolean\"},\n        \"login\": {\"type\": \"string\"},\n        \"id\": {\"type\": \"string\"},\n        \"name\": {\"type\": \"string\"}\n      }\n    },\n    \"label\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"name\", \"description\", \"color\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\"type\": \"string\"},\n        \"name\": {\"type\": \"string\"},\n        \"description\": {\"type\": \"string\"},\n        \"color\": {\"type\": \"string\"}\n      }\n    },\n    \"user\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"login\", \"name\", \"databaseId\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\"type\": \"string\"},\n        \"login\": {\"type\": \"string\"},\n        \"name\": {\"type\": \"string\"},\n        \"databaseId\": {\"type\": \"integer\"}\n      }\n    },\n    \"issue\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"number\",\n        \"title\",\n        \"state\",\n        \"stateReason\",\n        \"url\",\n        \"author\",\n        \"createdAt\",\n        \"updatedAt\",\n        \"closedAt\",\n        \"labels\",\n        \"assignees\",\n        \"body\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"number\": {\"type\": \"integer\"},\n        \"title\": {\"type\": \"string\"},\n        \"state\": {\"enum\": [\"OPEN\", \"CLOSED\"]},\n        \"stateReason\": {\"type\": \"string\"},\n        \"url\": {\"type\": \"string\"},\n        \"author\": {\"$ref\": \"#/$defs/author\"},\n        \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"updatedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"closedAt\": {\"anyOf\": [{\"type\": \"string\", \"format\": \"date-time\"}, {\"type\": \"null\"}]},\n        \"labels\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/label\"}},\n        \"assignees\": {\"type\": \"array\", \"items\": {\"$ref\": \"#/$defs/user\"}},\n        \"body\": {\"type\": \"string\"}\n      }\n    }\n  }\n}\n" } } }
