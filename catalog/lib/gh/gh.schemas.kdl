cmd "run" { cmd "list" { output "json" framing="json" { nusage-args "--json" "databaseId,number,attempt,name,displayTitle,workflowName,headBranch,headSha,event,status,conclusion,createdAt,updatedAt,startedAt,url"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"The workflow runs `gh run list --json` selects, one array\",\n  \"type\": \"array\",\n  \"items\": {\"$ref\": \"#/$defs/run\"},\n  \"$defs\": {\n    \"run\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"databaseId\",\n        \"number\",\n        \"attempt\",\n        \"name\",\n        \"displayTitle\",\n        \"workflowName\",\n        \"headBranch\",\n        \"headSha\",\n        \"event\",\n        \"status\",\n        \"conclusion\",\n        \"createdAt\",\n        \"updatedAt\",\n        \"startedAt\",\n        \"url\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"databaseId\": {\"type\": \"integer\"},\n        \"number\": {\"type\": \"integer\"},\n        \"attempt\": {\"type\": \"integer\"},\n        \"name\": {\"type\": \"string\"},\n        \"displayTitle\": {\"type\": \"string\"},\n        \"workflowName\": {\"type\": \"string\"},\n        \"headBranch\": {\"type\": \"string\"},\n        \"headSha\": {\"type\": \"string\"},\n        \"event\": {\"type\": \"string\"},\n        \"status\": {\"type\": \"string\"},\n        \"conclusion\": {\"type\": \"string\"},\n        \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"updatedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"startedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"url\": {\"type\": \"string\"}\n      }\n    }\n  }\n}\n" } } }
cmd "run" { cmd "view" { output "json" framing="json" { nusage-args "--json" "databaseId,number,attempt,name,displayTitle,workflowName,headBranch,headSha,event,status,conclusion,createdAt,updatedAt,startedAt,url,jobs"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"A workflow run, as `gh run view --json` selects its fields\",\n  \"$ref\": \"#/$defs/run\",\n  \"$defs\": {\n    \"run\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"databaseId\",\n        \"number\",\n        \"attempt\",\n        \"name\",\n        \"displayTitle\",\n        \"workflowName\",\n        \"headBranch\",\n        \"headSha\",\n        \"event\",\n        \"status\",\n        \"conclusion\",\n        \"createdAt\",\n        \"updatedAt\",\n        \"startedAt\",\n        \"url\",\n        \"jobs\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"databaseId\": {\n          \"type\": \"integer\"\n        },\n        \"number\": {\n          \"type\": \"integer\"\n        },\n        \"attempt\": {\n          \"type\": \"integer\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"displayTitle\": {\n          \"type\": \"string\"\n        },\n        \"workflowName\": {\n          \"type\": \"string\"\n        },\n        \"headBranch\": {\n          \"type\": \"string\"\n        },\n        \"headSha\": {\n          \"type\": \"string\"\n        },\n        \"event\": {\n          \"type\": \"string\"\n        },\n        \"status\": {\n          \"type\": \"string\"\n        },\n        \"conclusion\": {\n          \"type\": \"string\"\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"updatedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"startedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"url\": {\n          \"type\": \"string\"\n        },\n        \"jobs\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/$defs/job\"\n          }\n        }\n      }\n    },\n    \"step\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"name\",\n        \"status\",\n        \"conclusion\",\n        \"number\",\n        \"startedAt\",\n        \"completedAt\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"status\": {\n          \"type\": \"string\"\n        },\n        \"conclusion\": {\n          \"type\": \"string\"\n        },\n        \"number\": {\n          \"type\": \"integer\"\n        },\n        \"startedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"completedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        }\n      }\n    },\n    \"job\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"databaseId\",\n        \"name\",\n        \"status\",\n        \"conclusion\",\n        \"startedAt\",\n        \"completedAt\",\n        \"url\",\n        \"steps\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"databaseId\": {\n          \"type\": \"integer\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"status\": {\n          \"type\": \"string\"\n        },\n        \"conclusion\": {\n          \"type\": \"string\"\n        },\n        \"startedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"completedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"url\": {\n          \"type\": \"string\"\n        },\n        \"steps\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/$defs/step\"\n          }\n        }\n      }\n    }\n  }\n}\n" } } }
cmd "release" { cmd "list" { output "json" framing="json" { nusage-args "--json" "name,tagName,isDraft,isLatest,isPrerelease,isImmutable,createdAt,publishedAt"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"The releases `gh release list --json` selects, one array\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"required\": [\n      \"name\",\n      \"tagName\",\n      \"isDraft\",\n      \"isLatest\",\n      \"isPrerelease\",\n      \"isImmutable\",\n      \"createdAt\",\n      \"publishedAt\"\n    ],\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"name\": {\"type\": \"string\"},\n      \"tagName\": {\"type\": \"string\"},\n      \"isDraft\": {\"type\": \"boolean\"},\n      \"isLatest\": {\"type\": \"boolean\"},\n      \"isPrerelease\": {\"type\": \"boolean\"},\n      \"isImmutable\": {\"type\": \"boolean\"},\n      \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n      \"publishedAt\": {\"type\": \"string\", \"format\": \"date-time\"}\n    }\n  }\n}\n" } } }
cmd "release" { cmd "view" { output "json" framing="json" { nusage-args "--json" "tagName,name,body,isDraft,isPrerelease,isImmutable,createdAt,publishedAt,targetCommitish,url,author,assets"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"A release with its assets, as `gh release view --json` selects its fields\",\n  \"type\": \"object\",\n  \"required\": [\n    \"tagName\",\n    \"name\",\n    \"body\",\n    \"isDraft\",\n    \"isPrerelease\",\n    \"isImmutable\",\n    \"createdAt\",\n    \"publishedAt\",\n    \"targetCommitish\",\n    \"url\",\n    \"author\",\n    \"assets\"\n  ],\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"tagName\": {\"type\": \"string\"},\n    \"name\": {\"type\": \"string\"},\n    \"body\": {\"type\": \"string\"},\n    \"isDraft\": {\"type\": \"boolean\"},\n    \"isPrerelease\": {\"type\": \"boolean\"},\n    \"isImmutable\": {\"type\": \"boolean\"},\n    \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n    \"publishedAt\": {\"anyOf\": [{\"type\": \"string\", \"format\": \"date-time\"}, {\"type\": \"null\"}]},\n    \"targetCommitish\": {\"type\": \"string\"},\n    \"url\": {\"type\": \"string\"},\n    \"author\": {\n      \"type\": \"object\",\n      \"required\": [\"id\", \"login\"],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\"type\": \"string\"},\n        \"login\": {\"type\": \"string\"}\n      }\n    },\n    \"assets\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"url\",\n          \"apiUrl\",\n          \"id\",\n          \"name\",\n          \"label\",\n          \"size\",\n          \"digest\",\n          \"state\",\n          \"createdAt\",\n          \"updatedAt\",\n          \"downloadCount\",\n          \"contentType\"\n        ],\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"url\": {\"type\": \"string\"},\n          \"apiUrl\": {\"type\": \"string\"},\n          \"id\": {\"type\": \"string\"},\n          \"name\": {\"type\": \"string\"},\n          \"label\": {\"type\": \"string\"},\n          \"size\": {\"type\": \"integer\"},\n          \"digest\": {\"type\": [\"string\", \"null\"]},\n          \"state\": {\"type\": \"string\"},\n          \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n          \"updatedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n          \"downloadCount\": {\"type\": \"integer\"},\n          \"contentType\": {\"type\": \"string\"}\n        }\n      }\n    }\n  }\n}\n" } } }