cmd "run" { cmd "list" { output "json" framing="json" { nusage-args "--json" "databaseId,number,attempt,name,displayTitle,workflowName,headBranch,headSha,event,status,conclusion,createdAt,updatedAt,startedAt,url"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"The workflow runs `gh run list --json` selects, one array\",\n  \"type\": \"array\",\n  \"items\": {\"$ref\": \"#/$defs/run\"},\n  \"$defs\": {\n    \"run\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"databaseId\",\n        \"number\",\n        \"attempt\",\n        \"name\",\n        \"displayTitle\",\n        \"workflowName\",\n        \"headBranch\",\n        \"headSha\",\n        \"event\",\n        \"status\",\n        \"conclusion\",\n        \"createdAt\",\n        \"updatedAt\",\n        \"startedAt\",\n        \"url\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"databaseId\": {\"type\": \"integer\"},\n        \"number\": {\"type\": \"integer\"},\n        \"attempt\": {\"type\": \"integer\"},\n        \"name\": {\"type\": \"string\"},\n        \"displayTitle\": {\"type\": \"string\"},\n        \"workflowName\": {\"type\": \"string\"},\n        \"headBranch\": {\"type\": \"string\"},\n        \"headSha\": {\"type\": \"string\"},\n        \"event\": {\"type\": \"string\"},\n        \"status\": {\"type\": \"string\"},\n        \"conclusion\": {\"type\": \"string\"},\n        \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"updatedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"startedAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"url\": {\"type\": \"string\"}\n      }\n    }\n  }\n}\n" } } }
