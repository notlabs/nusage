cmd "pr" { cmd "list" { output "json" framing="json" { nusage-args "--json" "number,title,state,isDraft,url,author,headRefName,baseRefName,createdAt,updatedAt,closedAt,mergedAt,labels,reviewDecision,body,headRefOid,isCrossRepository,mergeable,mergeStateStatus,statusCheckRollup"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"The pull requests `gh pr list --json` selects, one array\",\n  \"type\": \"array\",\n  \"items\": {\n    \"$ref\": \"#/$defs/pull_request\"\n  },\n  \"$defs\": {\n    \"author\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"is_bot\",\n        \"login\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"is_bot\": {\n          \"type\": \"boolean\"\n        },\n        \"login\": {\n          \"type\": \"string\"\n        },\n        \"id\": {\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"label\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"id\",\n        \"name\",\n        \"description\",\n        \"color\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"description\": {\n          \"type\": \"string\"\n        },\n        \"color\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"pull_request\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"number\",\n        \"title\",\n        \"state\",\n        \"isDraft\",\n        \"url\",\n        \"author\",\n        \"headRefName\",\n        \"baseRefName\",\n        \"createdAt\",\n        \"updatedAt\",\n        \"closedAt\",\n        \"mergedAt\",\n        \"labels\",\n        \"reviewDecision\",\n        \"body\",\n        \"headRefOid\",\n        \"isCrossRepository\",\n        \"mergeable\",\n        \"mergeStateStatus\",\n        \"statusCheckRollup\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"number\": {\n          \"type\": \"integer\"\n        },\n        \"title\": {\n          \"type\": \"string\"\n        },\n        \"state\": {\n          \"enum\": [\n            \"OPEN\",\n            \"CLOSED\",\n            \"MERGED\"\n          ]\n        },\n        \"isDraft\": {\n          \"type\": \"boolean\"\n        },\n        \"url\": {\n          \"type\": \"string\"\n        },\n        \"author\": {\n          \"$ref\": \"#/$defs/author\"\n        },\n        \"headRefName\": {\n          \"type\": \"string\"\n        },\n        \"baseRefName\": {\n          \"type\": \"string\"\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"updatedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"closedAt\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ]\n        },\n        \"mergedAt\": {\n          \"anyOf\": [\n            {\n              \"type\": \"string\",\n              \"format\": \"date-time\"\n            },\n            {\n              \"type\": \"null\"\n            }\n          ]\n        },\n        \"labels\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"$ref\": \"#/$defs/label\"\n          }\n        },\n        \"reviewDecision\": {\n          \"enum\": [\n            \"\",\n            \"APPROVED\",\n            \"CHANGES_REQUESTED\",\n            \"REVIEW_REQUIRED\"\n          ]\n        },\n        \"body\": {\n          \"type\": \"string\"\n        },\n        \"headRefOid\": {\n          \"type\": \"string\"\n        },\n        \"isCrossRepository\": {\n          \"type\": \"boolean\"\n        },\n        \"mergeable\": {\n          \"enum\": [\n            \"MERGEABLE\",\n            \"CONFLICTING\",\n            \"UNKNOWN\"\n          ]\n        },\n        \"mergeStateStatus\": {\n          \"type\": \"string\"\n        },\n        \"statusCheckRollup\": {\n          \"anyOf\": [\n            {\n              \"type\": \"array\",\n              \"items\": {\n                \"anyOf\": [\n                  {\n                    \"$ref\": \"#/$defs/check_run\"\n                  },\n                  {\n                    \"$ref\": \"#/$defs/status_context\"\n                  }\n                ]\n              }\n            },\n            {\n              \"type\": \"null\"\n            }\n          ]\n        }\n      }\n    },\n    \"check_run\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"__typename\",\n        \"name\",\n        \"workflowName\",\n        \"status\",\n        \"conclusion\",\n        \"startedAt\",\n        \"completedAt\",\n        \"detailsUrl\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"__typename\": {\n          \"const\": \"CheckRun\"\n        },\n        \"name\": {\n          \"type\": \"string\"\n        },\n        \"workflowName\": {\n          \"type\": \"string\"\n        },\n        \"status\": {\n          \"type\": \"string\"\n        },\n        \"conclusion\": {\n          \"type\": \"string\"\n        },\n        \"startedAt\": {\n          \"type\": \"string\"\n        },\n        \"completedAt\": {\n          \"type\": \"string\"\n        },\n        \"detailsUrl\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"status_context\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"__typename\",\n        \"context\",\n        \"state\",\n        \"targetUrl\",\n        \"startedAt\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"__typename\": {\n          \"const\": \"StatusContext\"\n        },\n        \"context\": {\n          \"type\": \"string\"\n        },\n        \"state\": {\n          \"type\": \"string\"\n        },\n        \"targetUrl\": {\n          \"type\": \"string\"\n        },\n        \"startedAt\": {\n          \"type\": \"string\"\n        }\n      }\n    }\n  }\n}\n" } } }
