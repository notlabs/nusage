cmd "repo" { cmd "view" { output "json" framing="json" { nusage-args "--json" "name,nameWithOwner,owner,description,url,isPrivate,isArchived,isFork,defaultBranchRef,stargazerCount,forkCount,createdAt,updatedAt,pushedAt"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"A repository, as `gh repo view --json` selects its fields\",\n  \"$ref\": \"#/$defs/repository\",\n  \"$defs\": {\n    \"repository\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"name\",\n        \"nameWithOwner\",\n        \"owner\",\n        \"description\",\n        \"url\",\n        \"isPrivate\",\n        \"isArchived\",\n        \"isFork\",\n        \"defaultBranchRef\",\n        \"stargazerCount\",\n        \"forkCount\",\n        \"createdAt\",\n        \"updatedAt\",\n        \"pushedAt\"\n      ],\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": {\"type\": \"string\"},\n        \"nameWithOwner\": {\"type\": \"string\"},\n        \"owner\": {\n          \"type\": \"object\",\n          \"required\": [\"id\", \"login\"],\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"id\": {\"type\": \"string\"},\n            \"login\": {\"type\": \"string\"}\n          }\n        },\n        \"description\": {\"type\": \"string\"},\n        \"url\": {\"type\": \"string\"},\n        \"isPrivate\": {\"type\": \"boolean\"},\n        \"isArchived\": {\"type\": \"boolean\"},\n        \"isFork\": {\"type\": \"boolean\"},\n        \"defaultBranchRef\": {\n          \"type\": \"object\",\n          \"required\": [\"name\"],\n          \"additionalProperties\": false,\n          \"properties\": {\"name\": {\"type\": \"string\"}}\n        },\n        \"stargazerCount\": {\"type\": \"integer\"},\n        \"forkCount\": {\"type\": \"integer\"},\n        \"createdAt\": {\"type\": \"string\", \"format\": \"date-time\"},\n        \"updatedAt\": {\"type\": \"string\", \"format\": \"date-