// On each command `schemas/outputs.nuon` types: the wrapper owns `--json`, so the flags that
// transform or replace its JSON are hidden. `--jq` and `--template` rewrite the selection,
// `--web` opens a browser instead of printing, and `run view`'s log flags print a log.
// `^gh` keeps them all.
cmd "pr" {
    cmd "list" {
        flag "-q --jq" hide=#true
        flag "-t --template" hide=#true
        flag "-w --web" hide=#true
    }
    cmd "view" {
        flag "-q --jq" hide=#true
        flag "-t --template" hide=#true
        flag "-w --web" hide=#true
    }
    cmd "checks" {
        flag "-q --jq" hide=#true
        flag "-t --template" hide=#true
        flag "-w --web" hide=#true
        flag --watch hide=#true
    }
}
cmd "issue" {
    cmd "list" {
        flag "-q --jq" hide=#true
        flag "-t --template" hide=#true
        flag "-w --web" hide=#true
    }
    cmd "view" {
        flag "-q --jq" hide=#true
        flag "-t --template" hide=#true
        flag "-w --web" hide=#true
    }
}
cmd "repo" {
    cmd "list" {
        flag "-q --jq" hide=#true
        flag "-t --template" hide=#true
    }
    cmd "view" {
        flag "-q --jq" hide=#true
        flag "-t --template" hide=#true
        flag "-w --web" hide=#true
    }
}
cmd "run" {
    cmd "list" {
        flag "-q --jq" hide=#true
        flag "-t --template" hide=#true
    }
    cmd "view" {
        flag "-q --jq" hide=#true
        flag "-t --template" hide=#true
        flag "-w --web" hide=#true
        flag --log hide=#true
        flag --log-failed hide=#true
    }
}
cmd "release" {
    cmd "list" {
        flag "-q --jq" hide=#true
        flag "-t --template" hide=#true
    }
    cmd "view" {
        flag "-q --jq" hide=#true
        flag "-t --template" hide=#true
        flag "-w --web" hide=#true
    }
}
