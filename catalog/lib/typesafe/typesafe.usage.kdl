name "typesafe"
bin "typesafe"
about "TypeSafe AI"
long_about "A System One model answers named questions about a piece of content, the `state`, and\nreturns one typed answer per question rather than text: a yes/no probability (`noul`), a\nselection among named choices with their probabilities (`choice`), an expected score\nagainst an ordered rubric (`score`), or a located box in an image (`box`). The first System\nOne model is Jev, reached as `jev-latest`; `jev-preview` answers `box` questions.\n\nAuthenticate with an API key as a bearer token. Requests are JSON; the request body may be\nsent compressed with `Content-Encoding: zstd`. An unsuccessful response carries its reason\nin a JSON body, as `error`, `message` or `detail`, and every response carries\n`x-typesafe-request-id`. A rate-limited response says how long to wait in `retry-after`\nor `retry-after-ms`."
version "1"
cmd "list-models" help="List the models available to the account" {
    output "json" framing="json" default=#true {
        schema file="schemas/list-models.schema.json"
    }
}
cmd "system-one" help="Answer named questions about content" {
    flag "--type-safe-danger-zone-images" help="Opt in to image assets, which are experimental: `true` to send PNG or JPEG images in `assets`, as base64 data or multipart parts."
    output "json" framing="json" default=#true {
        schema file="schemas/system-one.schema.json"
    }
}
