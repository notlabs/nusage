cmd "ps" { output "json" framing="jsonl" { nusage-args "--format" "json" "--no-trunc"; schema "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"Docker Compose v5.6.1 ps JSON line\",\n  \"description\": \"ContainerContext accessors, with --format json --no-trunc. Display strings are retained as strings; Publishers may be null.\",\n  \"type\": \"object\",\n  \"required\": [\n    \"Command\",\n    \"CreatedAt\",\n    \"Engine\",\n    \"ExitCode\",\n    \"Health\",\n    \"ID\",\n    \"Image\",\n    \"Labels\",\n    \"LocalVolumes\",\n    \"Mounts\",\n    \"Name\",\n    \"Names\",\n    \"Networks\",\n    \"Ports\",\n    \"Project\",\n    \"Publishers\",\n    \"RunningFor\",\n    \"Service\",\n    \"Size\",\n    \"State\",\n    \"Status\"\n  ],\n  \"properties\": {\n    \"Command\": {\n      \"type\": \"string\"\n    },\n    \"CreatedAt\": {\n      \"type\": \"string\"\n    },\n    \"Engine\": {\n      \"type\": \"string\"\n    },\n    \"ExitCode\": {\n      \"type\": \"integer\"\n    },\n    \"Health\": {\n      \"type\": \"string\"\n    },\n    \"ID\": {\n      \"type\": \"string\"\n    },\n    \"Image\": {\n      \"type\": \"string\"\n    },\n    \"Labels\": {\n      \"type\": \"string\"\n    },\n    \"LocalVolumes\": {\n      \"type\": \"string\"\n    },\n    \"Mounts\": {\n      \"type\": \"string\"\n    },\n    \"Name\": {\n      \"type\": \"string\"\n    },\n    \"Names\": {\n      \"type\": \"string\"\n    },\n    \"Networks\": {\n      \"type\": \"string\"\n    },\n    \"Ports\": {\n      \"type\": \"string\"\n    },\n    \"Project\": {\n      \"type\": \"string\"\n    },\n    \"Publishers\": {\n      \"type\": [\n        \"array\",\n        \"null\"\n      ],\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"URL\",\n          \"TargetPort\",\n          \"PublishedPort\",\n          \"Protocol\"\n        ],\n        \"properties\": {\n          \"URL\": {\n            \"type\": \"string\"\n          },\n          \"TargetPort\": {\n            \"type\": \"integer\"\n          },\n          \"PublishedPort\": {\n            \"type\": \"integer\"\n          },\n          \"Protocol\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"RunningFor\": {\n      \"type\": \"string\"\n    },\n    \"Service\": {\n      \"type\": \"string\"\n    },\n    \"Size\": {\n      \"type\": \"string\"\n    },\n    \"State\": {\n      \"type\": \"string\"\n    },\n    \"Status\": {\n      \"type\": \"string\"\n    }\n  }\n}\n" } }