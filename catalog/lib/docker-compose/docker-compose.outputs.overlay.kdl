// Compose v5.6.1: cmd/compose/version.go and cmd/compose/list.go.
// These switches take precedence over --format, so the structured wrappers omit them.
// Use ^docker-compose for the original CLI's other output modes.
cmd "version" {
    flag "--short" hide=#true
    output "pretty" default=#true
    select "--format"
    output "json" framing="json" {
        schema #"""
{
  "type": "object",
  "required": ["version"],
  "properties": {"version": {"type": "string"}}
}
"""#
    }
}
cmd "ls" {
    flag "-q --quiet" hide=#true
    output "table" default=#true
    select "--format"
    output "json" framing="json" {
        schema #"""
{
  "type": "array",
  "items": {
    "type": "object",
    "required": ["Name", "Status", "ConfigFiles"],
    "properties": {
      "Name": {"type": "string"},
      "Status": {"type": "string"},
      "ConfigFiles": {"type": "string"}
    }
  }
}
"""#
    }
}

cmd "ps" {
    // The schema suite owns --format json --no-trunc. Other stdout modes are external-only.
    flag "--format" hide=#true
    flag "--no-trunc" hide=#true
    flag "-q --quiet" hide=#true
    flag "--services" hide=#true
    // Preserve Compose's default (true); a plain switch cannot express --orphans=false.
    flag "--orphans" hide=#true
    // The Cobra adapter loses pflag's StringArray type.
    flag "--status" var=#true
}
