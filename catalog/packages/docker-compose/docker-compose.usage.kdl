name docker-compose
bin docker-compose
version "5.6.1"
about "Docker Compose"
long_about "Define and run multi-container applications with Docker"
flag --dry-run help="Execute command in dry run mode" global=#true
flag --all-resources help="Include all resources, even those not used by services"
flag --ansi help="Control when to print ANSI control characters (\"never\"|\"always\"|\"auto\")" default=auto {
    arg <ANSI>
}
flag --compatibility help="Run compose in backward compatibility mode"
flag --env-file help="Specify an alternate environment file" {
    arg <ENV_FILE>
}
flag "-f --file" help="Compose configuration files" {
    arg <FILE>
}
flag --insecure-registry help="Use insecure registry to pull Compose OCI artifacts. Doesn't apply to images" hide=#true {
    arg <INSECURE_REGISTRY>
}
flag --no-ansi help="Do not print ANSI control characters (DEPRECATED)" hide=#true
flag --parallel help="Control max parallelism, -1 for unlimited" default="-1" {
    arg <PARALLEL>
}
flag --profile help="Specify a profile to enable" {
    arg <PROFILE>
}
flag --progress help="Set type of progress output (auto, tty, plain, json, quiet)" {
    arg <PROGRESS>
}
flag --project-directory help="Specify an alternate working directory\n(default: the path of the, first specified, Compose file)" {
    arg <PROJECT_DIRECTORY>
}
flag "-p --project-name" help="Project name" {
    arg <PROJECT_NAME>
}
flag --verbose help="Show more output" hide=#true
flag --workdir help="DEPRECATED! USE --project-directory INSTEAD.\nSpecify an alternate working directory\n(default: the path of the, first specified, Compose file)" hide=#true {
    arg <WORKDIR>
}
cmd alpha hide=#true subcommand_required=#true help="Experimental commands" {
    cmd generate help="EXPERIMENTAL - Generate a Compose file from existing containers" {
        flag --format help="Format the output. Values: [yaml | json]" default=yaml {
            arg <FORMAT>
        }
        flag --name help="Project name to set in the Compose file" {
            arg <NAME>
        }
        flag --project-dir help="Directory to use for the project" {
            arg <PROJECT_DIR>
        }
        arg "[CONTAINERS...]" required=#false
    }
    cmd viz help="EXPERIMENTAL - Generate a graphviz graph from your compose file" {
        flag --image help="Include service's image name in output graph"
        flag --indentation-size help="Number of tabs or spaces to use for indentation" default="1" {
            arg <INDENTATION_SIZE>
        }
        flag --networks help="Include service's attached networks in output graph"
        flag --ports help="Include service's exposed ports in output graph"
        flag --spaces help="If given, space character ' ' will be used to indent,\notherwise tab character '\\t' will be used"
    }
}
cmd attach help="Attach local standard input, output, and error streams to a service's running container" {
    flag --detach-keys help="Override the key sequence for detaching from a container." {
        arg <DETACH_KEYS>
    }
    flag --index help="index of the container if service has multiple replicas." default="0" {
        arg <INDEX>
    }
    flag --no-stdin help="Do not attach STDIN"
    flag --sig-proxy help="Proxy all received signals to the process" default="true"
}
cmd bridge help="Convert compose files into another model" {
    cmd convert help="Convert compose files to Kubernetes manifests, Helm charts, or another model" {
        flag "-o --output" help="The output directory for the Kubernetes resources" default=out {
            arg <OUTPUT>
        }
        flag --templates help="Directory containing transformation templates" {
            arg <TEMPLATES>
        }
        flag "-t --transformation" help="Transformation to apply to compose model (default: docker/compose-bridge-kubernetes)" {
            arg <TRANSFORMATION>
        }
        flag "-y --yes" help="Assume \"yes\" to the output directory overwrite prompt. For scripts/CI, where no interactive confirmation is possible"
    }
    cmd transformations help="Manage transformation images" {
        cmd create help="Create a new transformation" {
            flag "-f --from" help="Existing transformation to copy (default: docker/compose-bridge-kubernetes)" {
                arg <FROM>
            }
            arg "[OPTION]" required=#false
        }
        cmd list help="List available transformations" {
            alias ls
            flag --format help="Format the output. Values: [table | json]" default=table {
                arg <FORMAT>
            }
            flag "-q --quiet" help="Only display transformer names"
        }
    }
}
cmd build help="Build or rebuild services" {
    flag --build-arg help="Set build-time variables for services" {
        arg <BUILD_ARG>
    }
    flag --builder help="Set builder to use" {
        arg <BUILDER>
    }
    flag --check help="Check build configuration"
    flag --compress help="Compress the build context using gzip. DEPRECATED" hide=#true default="true"
    flag --force-rm help="Always remove intermediate containers. DEPRECATED" hide=#true default="true"
    flag "-m --memory" help="Set memory limit for the build container. Not supported by BuildKit." default="0" {
        arg <MEMORY>
    }
    flag --no-cache help="Do not use cache when building the image"
    flag --no-rm help="Do not remove intermediate containers after a successful build. DEPRECATED" hide=#true
    flag --parallel help="Build images in parallel. DEPRECATED" hide=#true default="true"
    flag --print help="Print equivalent bake file"
    flag --progress help="Set type of ui output (auto, tty, plain, json, quiet)" hide=#true {
        arg <PROGRESS>
    }
    flag --provenance help="Add a provenance attestation" {
        arg <PROVENANCE>
    }
    flag --pull help="Always attempt to pull a newer version of the image"
    flag --push help="Push service images"
    flag "-q --quiet" help="Suppress the build output"
    flag --sbom help="Add a SBOM attestation" {
        arg <SBOM>
    }
    flag --ssh help="Set SSH authentications used when building service images. (use 'default' for using your default SSH Agent)" {
        arg <SSH>
    }
    flag --with-dependencies help="Also build dependencies (transitively)"
    arg "[SERVICE...]" required=#false
}
cmd commit help="Create a new image from a service container's changes" {
    flag "-a --author" help="Author (e.g., \"John Hannibal Smith <hannibal@a-team.com>\")" {
        arg <AUTHOR>
    }
    flag "-c --change" help="Apply Dockerfile instruction to the created image" {
        arg <CHANGE>
    }
    flag --index help="index of the container if service has multiple replicas." default="0" {
        arg <INDEX>
    }
    flag "-m --message" help="Commit message" {
        arg <MESSAGE>
    }
    flag "-p --pause" help="Pause container during commit" default="true"
    arg "[REPOSITORY[:TAG]]" required=#false
}
cmd config help="Parse, resolve and render compose file in canonical format" {
    flag --environment help="Print environment used for interpolation."
    flag --format help="Format the output. Values: [yaml | json]" {
        arg <FORMAT>
    }
    flag --hash help="Print the service config hash, one per line." {
        arg <HASH>
    }
    flag --images help="Print the image names, one per line."
    flag --lock-image-digests help="Produces an override file with image digests"
    flag --models help="Print the model names, one per line."
    flag --networks help="Print the network names, one per line."
    flag --no-consistency help="Don't check model consistency - warning: may produce invalid Compose output"
    flag --no-env-resolution help="Don't resolve service env files"
    flag --no-interpolate help="Don't interpolate environment variables"
    flag --no-normalize help="Don't normalize compose model"
    flag --no-path-resolution help="Don't resolve file paths"
    flag "-o --output" help="Save to file (default to stdout)" {
        arg <OUTPUT>
    }
    flag --profiles help="Print the profile names, one per line."
    flag "-q --quiet" help="Only validate the configuration, don't print anything"
    flag --resolve-image-digests help="Pin image tags to digests"
    flag --services help="Print the service names, one per line."
    flag --variables help="Print model variables and default values."
    flag --volumes help="Print the volume names, one per line."
    arg "[SERVICE...]" required=#false
}
cmd cp help="Copy files/folders between a service container and the local filesystem" {
    flag --all help="Include containers created by the run command"
    flag "-a --archive" help="Archive mode (copy all uid/gid information)"
    flag "-L --follow-link" help="Always follow symbol link in SRC_PATH"
    flag --index help="Index of the container if service has multiple replicas" default="0" {
        arg <INDEX>
    }
}
cmd create help="Creates containers for a service" {
    flag --build help="Build images before starting containers"
    flag --force-recreate help="Recreate containers even if their configuration and image haven't changed"
    flag --no-build help="Don't build an image, even if it's policy"
    flag --no-recreate help="If containers already exist, don't recreate them. Incompatible with --force-recreate."
    flag --pull help="Pull image before running (\"always\"|\"missing\"|\"never\"|\"build\")" default=policy {
        arg <PULL>
    }
    flag --quiet-pull help="Pull without printing progress information"
    flag --remove-orphans help="Remove containers for services not defined in the Compose file"
    flag --scale help="Scale SERVICE to NUM instances. Overrides the `scale` setting in the Compose file if present." {
        arg <SCALE>
    }
    flag "-y --yes" help="Assume \"yes\" as answer to all prompts and run non-interactively"
    arg "[SERVICE...]" required=#false
}
cmd docker-cli-plugin-hooks hide=#true
cmd down help="Stop and remove containers, networks" {
    flag --remove-orphans help="Remove containers for services not defined in the Compose file"
    flag --rmi help="Remove images used by services. \"local\" remove only images that don't have a custom tag (\"local\"|\"all\")" {
        arg <RMI>
    }
    flag "-t --timeout" help="Specify a shutdown timeout in seconds" default="0" {
        arg <TIMEOUT>
    }
    flag "-v --volumes" help="Remove named volumes declared in the \"volumes\" section of the Compose file and anonymous volumes attached to containers"
    arg "[SERVICES]" required=#false
}
cmd events help="Receive real time events from containers" {
    flag --json help="Output events as a stream of json objects"
    flag --since help="Show all events created since timestamp" {
        arg <SINCE>
    }
    flag --until help="Stream events until this timestamp" {
        arg <UNTIL>
    }
    arg "[SERVICE...]" required=#false
}
cmd exec help="Execute a command in a running container" {
    flag "-d --detach" help="Detached mode: Run command in the background"
    flag "-e --env" help="Set environment variables" {
        arg <ENV>
    }
    flag --index help="Index of the container if service has multiple replicas" default="0" {
        arg <INDEX>
    }
    flag "-i --interactive" help="Keep STDIN open even if not attached" hide=#true default="true"
    flag "-T --no-tty" help="Disable pseudo-TTY allocation. By default 'docker compose exec' allocates a TTY." default="true"
    flag --privileged help="Give extended privileges to the process"
    flag "-t --tty" help="Allocate a pseudo-TTY" hide=#true default="true"
    flag "-u --user" help="Run the command as this user" {
        arg <USER>
    }
    flag "-w --workdir" help="Path to workdir directory for this command" {
        arg <WORKDIR>
    }
    arg "[ARGS...]" required=#false
}
cmd export help="Export a service container's filesystem as a tar archive" {
    flag --index help="index of the container if service has multiple replicas." default="0" {
        arg <INDEX>
    }
    flag "-o --output" help="Write to a file, instead of STDOUT" {
        arg <OUTPUT>
    }
}
cmd images help="List images used by the created containers" {
    flag --format help="Format the output. Values: [table | json]" default=table {
        arg <FORMAT>
    }
    flag "-q --quiet" help="Only display IDs"
    arg "[SERVICE...]" required=#false
}
cmd kill help="Force stop service containers" {
    flag --remove-orphans help="Remove containers for services not defined in the Compose file"
    flag "-s --signal" help="SIGNAL to send to the container" default=SIGKILL {
        arg <SIGNAL>
    }
    arg "[SERVICE...]" required=#false
}
cmd logs help="View output from containers" {
    flag "-f --follow" help="Follow log output"
    flag --index help="index of the container if service has multiple replicas" default="0" {
        arg <INDEX>
    }
    flag --no-color help="Produce monochrome output"
    flag --no-log-prefix help="Don't print prefix in logs"
    flag --since help="Show logs since timestamp (e.g. 2013-01-02T13:23:37Z) or relative (e.g. 42m for 42 minutes)" {
        arg <SINCE>
    }
    flag "-n --tail" help="Number of lines to show from the end of the logs for each container" default=all {
        arg <TAIL>
    }
    flag "-t --timestamps" help="Show timestamps"
    flag --until help="Show logs before a timestamp (e.g. 2013-01-02T13:23:37Z) or relative (e.g. 42m for 42 minutes)" {
        arg <UNTIL>
    }
    arg "[SERVICE...]" required=#false
}
cmd ls help="List running compose projects" {
    flag "-a --all" help="Show all stopped Compose projects"
    flag --filter help="Filter output based on conditions provided" {
        arg <FILTER>
    }
    flag --format help="Format the output. Values: [table | json]" default=table {
        arg <FORMAT>
    }
    flag "-q --quiet" help="Only display project names"
}
cmd pause help="Pause services" {
    arg "[SERVICE...]" required=#false
}
cmd port help="List port mappings or print the public port for a specific mapping for the service" {
    flag --index help="Index of the container if service has multiple replicas" default="0" {
        arg <INDEX>
    }
    flag --protocol help="tcp or udp" default=tcp {
        arg <PROTOCOL>
    }
    arg "[PRIVATE_PORT]" required=#false
}
cmd ps help="List containers" {
    flag "-a --all" help="Show all stopped containers (including those created by the run command)"
    flag --filter help="Filter services by a property (supported filters: status)" {
        arg <FILTER>
    }
    flag --format help="Format output using a custom template:\n'table':            Print output in table format with column headers (default)\n'table TEMPLATE':   Print output in table format using the given Go template\n'json':             Print in JSON format\n'TEMPLATE':         Print output using the given Go template.\nRefer to https://docs.docker.com/go/formatting/ for more information about formatting output with templates" {
        arg <FORMAT>
    }
    flag --no-trunc help="Don't truncate output"
    flag --orphans help="Include orphaned services (not declared by project)" default="true"
    flag "-q --quiet" help="Only display IDs"
    flag --services help="Display services"
    flag --status help="Filter services by status. Values: [paused | restarting | removing | running | dead | created | exited]" {
        arg <STATUS>
    }
    arg "[SERVICE...]" required=#false
}
cmd publish help="Publish compose application" {
    flag --app help="Published compose application (includes referenced images)"
    flag --insecure-registry help="Use insecure registry" hide=#true
    flag --oci-version help="OCI image/artifact specification version (automatically determined by default)" {
        arg <OCI_VERSION>
    }
    flag --resolve-image-digests help="Pin image tags to digests"
    flag --with-env help="Include environment variables in the published OCI artifact"
    flag "-y --yes" help="Assume \"yes\" as answer to all prompts"
}
cmd pull help="Pull service images" {
    flag --ignore-buildable help="Ignore images that can be built"
    flag --ignore-pull-failures help="Pull what it can and ignores images with pull failures"
    flag --include-deps help="Also pull services declared as dependencies"
    flag --no-parallel help="DEPRECATED disable parallel pulling" hide=#true default="true"
    flag --parallel help="DEPRECATED pull multiple images in parallel" hide=#true default="true"
    flag --policy help="Apply pull policy (\"missing\"|\"always\")" {
        arg <POLICY>
    }
    flag "-q --quiet" help="Pull without printing progress information"
    arg "[SERVICE...]" required=#false
}
cmd push help="Push service images" {
    flag --ignore-push-failures help="Push what it can and ignores images with push failures"
    flag --include-deps help="Also push images of services declared as dependencies"
    flag "-q --quiet" help="Push without printing progress information"
    arg "[SERVICE...]" required=#false
}
cmd restart help="Restart service containers" {
    flag --no-deps help="Don't restart dependent services"
    flag "-t --timeout" help="Specify a shutdown timeout in seconds" default="0" {
        arg <TIMEOUT>
    }
    arg "[SERVICE...]" required=#false
}
cmd rm help="Removes stopped service containers" {
    long_help "Removes stopped service containers\n\nBy default, anonymous volumes attached to containers will not be removed. You\ncan override this with -v. To list all volumes, use \"docker volume ls\".\n\nAny data which is not in a volume will be lost."
    flag "-a --all" help="Deprecated - no effect" hide=#true
    flag "-f --force" help="Don't ask to confirm removal"
    flag "-s --stop" help="Stop the containers, if required, before removing"
    flag "-v --volumes" help="Remove any anonymous volumes attached to containers"
    arg "[SERVICE...]" required=#false
}
cmd run help="Run a one-off command on a service" {
    flag --build help="Build image before starting container"
    flag --cap-add help="Add Linux capabilities" {
        arg <CAP_ADD>
    }
    flag --cap-drop help="Drop Linux capabilities" {
        arg <CAP_DROP>
    }
    flag "-d --detach" help="Run container in background and print container ID"
    flag --entrypoint help="Override the entrypoint of the image" {
        arg <ENTRYPOINT>
    }
    flag "-e --env" help="Set environment variables" {
        arg <ENV>
    }
    flag --env-from-file help="Set environment variables from file" {
        arg <ENV_FROM_FILE>
    }
    flag "-i --interactive" help="Keep STDIN open even if not attached" default="true"
    flag "-l --label" help="Add or override a label" {
        arg <LABEL>
    }
    flag --name help="Assign a name to the container" {
        arg <NAME>
    }
    flag --no-deps help="Don't start linked services"
    flag "-T --no-tty" help="Disable pseudo-TTY allocation (default: auto-detected)" default="true"
    flag "-p --publish" help="Publish a container's port(s) to the host" {
        arg <PUBLISH>
    }
    flag --pull help="Pull image before running (\"always\"|\"missing\"|\"never\")" default=policy {
        arg <PULL>
    }
    flag "-q --quiet" help="Don't print anything to STDOUT"
    flag --quiet-build help="Suppress progress output from the build process"
    flag --quiet-pull help="Pull without printing progress information"
    flag --remove-orphans help="Remove containers for services not defined in the Compose file"
    flag --rm help="Automatically remove the container when it exits"
    flag "-P --service-ports" help="Run command with all service's ports enabled and mapped to the host"
    flag "-t --tty" help="Allocate a pseudo-TTY" hide=#true default="true"
    flag --use-aliases help="Use the service's network useAliases in the network(s) the container connects to"
    flag "-u --user" help="Run as specified username or uid" {
        arg <USER>
    }
    flag "-v --volume" help="Bind mount a volume" {
        arg <VOLUME>
    }
    flag "-w --workdir" help="Working directory inside the container" {
        arg <WORKDIR>
    }
    arg "[ARGS...]" required=#false
}
cmd scale help="Scale services" {
    flag --no-deps help="Don't start linked services"
    arg "[SERVICE=REPLICAS...]" required=#false
}
cmd start help="Start services" {
    flag --wait help="Wait for services to be running|healthy. Implies detached mode."
    flag --wait-timeout help="Maximum duration in seconds to wait for the project to be running|healthy" default="0" {
        arg <WAIT_TIMEOUT>
    }
    arg "[SERVICE...]" required=#false
}
cmd stats help="Display a live stream of container(s) resource usage statistics" {
    flag "-a --all" help="Show all containers (default shows just running)"
    flag --format help="Format output using a custom template:\n'table':            Print output in table format with column headers (default)\n'table TEMPLATE':   Print output in table format using the given Go template\n'json':             Print in JSON format\n'TEMPLATE':         Print output using the given Go template.\nRefer to https://docs.docker.com/engine/cli/formatting/ for more information about formatting output with templates" {
        arg <FORMAT>
    }
    flag --no-stream help="Disable streaming stats and only pull the first result"
    flag --no-trunc help="Do not truncate output"
    arg "[SERVICE]" required=#false
}
cmd stop help="Stop services" {
    flag "-t --timeout" help="Specify a shutdown timeout in seconds" default="0" {
        arg <TIMEOUT>
    }
    arg "[SERVICE...]" required=#false
}
cmd top help="Display the running processes" {
    arg "[SERVICES...]" required=#false
}
cmd unpause help="Unpause services" {
    arg "[SERVICE...]" required=#false
}
cmd up help="Create and start containers" {
    flag --abort-on-container-exit help="Stops all containers if any container was stopped. Incompatible with -d"
    flag --abort-on-container-failure help="Stops all containers if any container exited with failure. Incompatible with -d"
    flag --always-recreate-deps help="Recreate dependent containers. Incompatible with --no-recreate."
    flag --attach help="Restrict attaching to the specified services. Incompatible with --attach-dependencies." {
        arg <ATTACH>
    }
    flag --attach-dependencies help="Automatically attach to log output of dependent services"
    flag --build help="Build images before starting containers"
    flag "-d --detach" help="Detached mode: Run containers in the background"
    flag --exit-code-from help="Return the exit code of the selected service container. Implies --abort-on-container-exit" {
        arg <EXIT_CODE_FROM>
    }
    flag --force-recreate help="Recreate containers even if their configuration and image haven't changed"
    flag --menu help="Enable interactive shortcuts when running attached. Incompatible with --detach. Can also be enable/disable by setting COMPOSE_MENU environment var."
    flag --no-attach help="Do not attach (stream logs) to the specified services" {
        arg <NO_ATTACH>
    }
    flag --no-build help="Don't build an image, even if it's policy"
    flag --no-color help="Produce monochrome output"
    flag --no-deps help="Don't start linked services"
    flag --no-log-prefix help="Don't print prefix in logs"
    flag --no-recreate help="If containers already exist, don't recreate them. Incompatible with --force-recreate."
    flag --no-start help="Don't start the services after creating them"
    flag --pull help="Pull image before running (\"always\"|\"missing\"|\"never\")" default=policy {
        arg <PULL>
    }
    flag --quiet-build help="Suppress the build output"
    flag --quiet-pull help="Pull without printing progress information"
    flag --remove-orphans help="Remove containers for services not defined in the Compose file"
    flag "-V --renew-anon-volumes" help="Recreate anonymous volumes instead of retrieving data from the previous containers"
    flag --scale help="Scale SERVICE to NUM instances. Overrides the `scale` setting in the Compose file if present." {
        arg <SCALE>
    }
    flag "-t --timeout" help="Use this timeout in seconds for container shutdown when attached or when containers are already running" default="0" {
        arg <TIMEOUT>
    }
    flag --timestamps help="Show timestamps"
    flag --wait help="Wait for services to be running|healthy. Implies detached mode."
    flag --wait-timeout help="Maximum duration in seconds to wait for the project to be running|healthy" default="0" {
        arg <WAIT_TIMEOUT>
    }
    flag "-w --watch" help="Watch source code and rebuild/refresh containers when files are updated."
    flag "-y --yes" help="Assume \"yes\" as answer to all prompts and run non-interactively"
    arg "[SERVICE...]" required=#false
}
cmd version help="Show the Docker Compose version information" {
    flag "-f --format" help="Format the output. Values: [pretty | json]. (Default: pretty)" {
        arg <FORMAT>
    }
    flag --short help="Shows only Compose's version number"
}
cmd volumes help="List volumes" {
    flag --format help="Format output using a custom template:\n'table':            Print output in table format with column headers (default)\n'table TEMPLATE':   Print output in table format using the given Go template\n'json':             Print in JSON format\n'TEMPLATE':         Print output using the given Go template.\nRefer to https://docs.docker.com/go/formatting/ for more information about formatting output with templates" default=table {
        arg <FORMAT>
    }
    flag "-q --quiet" help="Only display volume names"
    arg "[SERVICE...]" required=#false
}
cmd wait help="Block until containers of all (or specified) services stop." {
    flag --down-project help="Drops project when the first container stops"
    arg "[SERVICE...]" required=#false
}
cmd watch help="Watch build context for service and rebuild/refresh containers when files are updated" {
    flag --no-up help="Do not build & start services before watching"
    flag --prune help="Prune dangling images on rebuild" default="true"
    flag --quiet help="hide build output"
    arg "[SERVICE...]" required=#false
}
