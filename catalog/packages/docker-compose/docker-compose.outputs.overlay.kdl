// Each output is declared from the Compose source at the spec's version. A switch that takes
// precedence over --format is hidden; ^docker-compose keeps the CLI's other output modes.

// cmd/compose/version.go writes a literal JSON object.
cmd "version" {
    flag "--short" hide=#true
    output "pretty" default=#true
    select "--format"
    output "json" framing="json" {
        schema #"""
{
  "type": "object",
  "required": ["version"],
  "properties": {"version": {"type": "string"}}
}
"""#
    }
}
// cmd/compose/list.go builds the rows its formatter writes as one array. Read from the
// serializer; not yet run against a Docker daemon.
cmd "ls" {
    flag "-q --quiet" hide=#true
    output "table" default=#true
    select "--format"
    output "json" framing="json" {
        schema #"""
{
  "type": "array",
  "items": {
    "type": "object",
    "required": ["Name", "Status", "ConfigFiles"],
    "properties": {
      "Name": {"type": "string"},
      "Status": {"type": "string"},
      "ConfigFiles": {"type": "string"}
    }
  }
}
"""#
    }
}
