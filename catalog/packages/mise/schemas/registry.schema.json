{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mise registry [tool] --json",
  "$defs": {
    "security": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "checksum"
            },
            "algorithm": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "github_attestations"
            },
            "signer_workflow": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "slsa"
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "minisign"
            },
            "public_key": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "cosign",
                "packslip",
                "gpg"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "tool": {
      "type": "object",
      "properties": {
        "short": {
          "type": "string"
        },
        "backends": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "security": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/security"
          },
          "minItems": 1
        }
      },
      "required": [
        "short",
        "backends"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/tool"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  ]
}
