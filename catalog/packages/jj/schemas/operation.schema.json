{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "An operation, one line of `jj operation log`",
  "type": "object",
  "required": [
    "id",
    "parents",
    "time",
    "description",
    "hostname",
    "username",
    "is_snapshot",
    "workspace_name",
    "attributes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]+$"
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]+$"
      }
    },
    "time": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "description": {
      "type": "string"
    },
    "hostname": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "is_snapshot": {
      "type": "boolean"
    },
    "workspace_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
