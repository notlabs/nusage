{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The releases `gh release list --json` selects, one array",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "tagName",
      "isDraft",
      "isLatest",
      "isPrerelease",
      "isImmutable",
      "createdAt",
      "publishedAt"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {"type": "string"},
      "tagName": {"type": "string"},
      "isDraft": {"type": "boolean"},
      "isLatest": {"type": "boolean"},
      "isPrerelease": {"type": "boolean"},
      "isImmutable": {"type": "boolean"},
      "createdAt": {"type": "string", "format": "date-time"},
      "publishedAt": {"type": "string", "format": "date-time"}
    }
  }
}
