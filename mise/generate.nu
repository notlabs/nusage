#!/usr/bin/env nusage
#USAGE flag "--out <dir>" default="generated" help="Where the module and the spec it completes against are written"
# The module for mise: the spec of the mise on PATH, the output every `--json` switch
# selects, and the overlays here, generated by the nusage on PATH.
let out = $usage.flags.out
mkdir $out
let spec = $out | path join mise.usage.kdl
let json = $out | path join mise.json.kdl
^mise usage | save --force $spec
^nusage overlay $spec --switch=--json --framing=json | save --force $json
^nusage generate $spec --overlay $json --out ($out | path join mise.nu)
