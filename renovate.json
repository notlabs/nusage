{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The mise version the workflows install",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["uses: jdx/mise-action@[^\\n]*\\n\\s+with:\\n\\s+version: (?<currentValue>\\S+)"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "The jj on PATH and the jj-cli its spec is read from move together; `mise run //catalog:spec jj` then writes the spec for the new version",
      "matchDepNames": ["jujutsu", "jj-cli"],
      "groupName": "jj"
    }
  ]
}
