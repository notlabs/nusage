{
  "registered": [
    {
      "id": "nu:app",
      "root": "app"
    },
    {
      "id": "nu:lib",
      "root": "lib"
    }
  ],
  "projects": [
    {
      "id": "nu:root",
      "root": "."
    },
    {
      "id": "nu:app",
      "root": "app"
    },
    {
      "id": "nu:lib",
      "root": "lib"
    }
  ],
  "configs": [
    {
      "root": "app",
      "file": "app/mise.toml",
