              "depends_add": [
                "nu:lib"
              ]
            }
          }
        }
      }
    }
  ],
  "tasks": [
    {
      "name": "//app:check",
      "source": "/workspace/app/mise.toml",
      "depends": [
        "//lib:check"
      ],
      "run": [],
      "dir": "/workspace/lib"
    },
    {
      "name": "//lib:check",
      "source": "/workspace/lib/mise.toml",
      "depends": [],
      "run": [],
      "dir": "/workspace/lib"
    }
  ]
}
