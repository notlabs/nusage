{"Dir":{{printf "%q" .Dir}},"Module":{{if .Module}}{"Path":{{printf "%q" .Module.Path}},"Dir":{{printf "%q" .Module.Dir}}}{{else}}null{{end}},"GoFiles":[{{range $i, $v := .GoFiles}}{{if $i}},{{end}}{{printf "%q" $v}}{{end}}],"TestGoFiles":[{{range $i, $v := .TestGoFiles}}{{if $i}},{{end}}{{printf "%q" $v}}{{end}}],"XTestGoFiles":[{{range $i, $v := .XTestGoFiles}}{{if $i}},{{end}}{{printf "%q" $v}}{{end}}]}
