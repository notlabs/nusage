diff --git a/src/supported_langs.rs b/src/supported_langs.rs
index 9304d16..7757d88 100644
--- a/src/supported_langs.rs
+++ b/src/supported_langs.rs
@@ -1621,6 +1621,56 @@ pub static SUPPORTED_LANGUAGES: LazyLock<Vec<LangProfile>> = LazyLock::new(|| {
             extra_comment_nodes: &[],
             allow_parse_errors: false,
         },
+        LangProfile {
+            name: "Nushell",
+            alternate_names: &["nu"],
+            extensions: &["nu", "nuon"],
+            file_names: &[],
+            language: tree_sitter_nu::LANGUAGE.into(),
+            // Strings are merged as a whole, quotes and interpolations included.
+            atomic_nodes: &["val_string", "val_interpolated", "shebang"],
+            commutative_parents: vec![
+                // Nushell predeclares the `def`s and `extern`s of a block before parsing its
+                // pipelines, so their order in a script, a module or any other block does not
+                // matter. Whole `use` statements keep their order: imports can shadow the
+                // same command name, so combining them could silently select one side.
+                // Everything else in a block runs in order too (pipelines, `let`, `const`,
+                // `alias`) and is left alone.
+                CommutativeParent::without_delimiters("nu_script", "\n").restricted_to(vec![
+                    ChildrenGroup::with_separator(&["decl_def", "decl_extern"], "\n\n"),
+                ]),
+                CommutativeParent::new("block", "{\n", "\n", "\n}").restricted_to(vec![
+                    ChildrenGroup::with_separator(&["decl_def", "decl_extern"], "\n\n"),
+                ]),
+                // The entries of a record are keyed, so their order does not matter. Spreads
+                // (`...$other`) are not entries and stay in place.
+                CommutativeParent::without_delimiters("record_body", "\n")
+                    .restricted_to_groups(&[&["record_entry"]]),
+                // The commands a `use` imports: `use foo [a b c]`.
+                CommutativeParent::new("command_list", "[", " ", "]")
+                    .restricted_to_groups(&[&["cmd_identifier", "val_string"]]),
+            ],
+            signatures: vec![
+                // A command is named either way, unquoted or quoted; the signature takes
+                // whichever is present.
+                signature(
+                    "decl_def",
+                    vec![vec![Field("unquoted_name")], vec![Field("quoted_name")]],
+                ),
+                signature(
+                    "decl_extern",
+                    vec![vec![Field("unquoted_name")], vec![Field("quoted_name")]],
+                ),
+                signature("decl_use", vec![vec![]]),
+                signature("record_entry", vec![vec![Field("key")]]),
+                signature("cmd_identifier", vec![vec![]]),
+                signature("val_string", vec![vec![]]),
+            ],
+            injections: None,
+            flattened_nodes: &[],
+            extra_comment_nodes: &[],
+            allow_parse_errors: false,
+        },
     ]
 });
 
