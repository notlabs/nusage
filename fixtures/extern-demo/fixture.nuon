# An extern fixture: no scripts, so no shim or interpreter checks. `extern --strict` and
# `@structured` are 0.117 syntax; a Nushell that does not parse `requires_syntax` skips the
# fixture's checks. The Rust test still holds the generator to expected/demo.nu.
{
    requires_syntax: "module m {\n@structured [] { from json }\nexport extern --strict x []\n}",
}
