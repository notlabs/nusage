# A command from an `include`: its own json output, selected by the inherited `--format`. The
# included file is not read for annotations, so the output is decoded but not typed.
{
    cmd: [list],
    invoke: "rep list --format json",
    argv: [list, --format, json],
    stdout: "[\"a\", \"b\"]",
    output: [a, b],
}
