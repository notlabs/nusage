#!/usr/bin/env nusage
#USAGE flag "--out <dir>" default="generated" help="Where the module goes"
# The module for jj, generated by the nusage on PATH from the committed spec and the overlay
# the schemas here declare: each JSON lines output asked for with its template.
let out = $usage.flags.out
mkdir $out
let schemas = $out | path join jj.schemas.kdl
^nusage ../schemas/overlay.nu schemas/outputs.nuon | save --force $schemas
^nusage generate jj.usage.kdl --overlay $schemas --out ($out | path join jj.nu)
