# A schema with `$defs`: the dependencies are a table whose optional `since` is a datetime,
# converted on each row, `meta` a nested record whose `took` is optional and counts seconds,
# `icon` is base64, `score` a nullable number.
{
    cmd: [report],
    invoke: "probe report",
    argv: [report],
    stdout: "{\"name\": \"x\", \"dependencies\": [{\"name\": \"a\", \"version\": \"1\", \"since\": \"2024-05-01T00:00:00Z\"}, {\"name\": \"b\", \"version\": \"2\", \"optional\": true}], \"meta\": {\"built\": \"2024-06-01T00:00:00Z\", \"took\": 1.5}, \"tags\": [\"t\"], \"icon\": \"aGk=\", \"score\": null}",
    output: {name: x, dependencies: [[name, version, optional, since]; [a, "1", null, 2024-05-01T00:00:00+00:00], [b, "2", true, null]], meta: {built: 2024-06-01T00:00:00+00:00, took: 1500ms}, tags: [t], icon: 0x[6869], score: null},
}
