{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nus inspect",
  "description": "Resolved command shadows and findings from the script analyzer. This is not a complete call or dependency graph.",
  "type": "object",
  "required": [
    "script",
    "calls",
    "findings",
    "header",
    "module_error"
  ],
  "additionalProperties": false,
  "properties": {
    "script": {
      "type": "string",
      "description": "Absolute path of the caller."
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "target",
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "command": {
            "type": "object",
            "description": "The command model serialized by nus model."
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "span",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "span": {
            "type": "object",
            "description": "Zero-based, end-exclusive UTF-8 byte offsets in the caller.",
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "header": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "path",
        "line",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "message": {
          "type": "string"
        }
      }
    },
    "module_error": {
      "type": [
        "string",
        "null"
      ],
      "description": "Package or module resolution failure, including tool version mismatches in nested callees. Null when preparation succeeds."
    },
    "graph": {
      "type": "object",
      "required": [
        "nodes",
        "edges",
        "findings"
      ],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "script",
                  "module"
                ]
              },
              "path": {
                "type": "string",
                "description": "Absolute script file or module directory."
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "calls",
                  "imports"
                ]
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "script",
              "span",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "message": {
                "type": "string"
              },
              "span": {
                "type": "object",
                "description": "Zero-based, end-exclusive UTF-8 byte offsets in the caller.",
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "script": {
                "type": "string"
              }
            }
          }
        }
      },
      "description": "Known recursive preparation dependencies. Present only with --recursive; a module_error can leave this graph partial."
    }
  }
}
