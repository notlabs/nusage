// Nushell's own command line, as `nu --help` of the Nushell nusage is built against lists
// it: what `nus nu` reads its arguments by, to tell Nushell's flags from a script and the
// script's own arguments, which `double_dash="automatic"` gives everything after the script.
// `version` is that Nushell's; a test holds it to the Nushell crates in Cargo.lock, and the
// flags to the `nu` on PATH when that is the same version.
name "nu"
bin "nu"
version "0.116.1"
about "The nushell language and shell"
flag "-h --help" help="show this help message"
flag "-v --version" help="print the version"
flag "-i --interactive" help="start as an interactive shell"
flag "-l --login" help="start as a login shell"
flag "-c --commands <string>" help="run the given commands and then exit"
flag "-e --execute <string>" help="run the given commands and then enter an interactive shell"
flag "-m --table-mode <string>" help="the table mode to use. rounded is default."
flag "--error-style <string>" help="the error style to use (fancy or plain). default: fancy"
flag "--no-newline" help="print the result for --commands(-c) without a newline"
flag "--stdin" help="redirect standard input to a command (with `-c`) or a script file"
flag "--mcp" help="start nu's model context protocol server"
flag "--mcp-transport <string>" help="transport to use for MCP server (stdio or http)"
flag "--mcp-port <int>" help="port for MCP HTTP transport (default 8080)"
flag "--mcp-host <string>" help="host for MCP HTTP transhost (default 127.0.0.1)"
flag "-I --include-path <string>" help="set the NU_LIB_DIRS for the given script"
flag "-n --no-config-file" help="start with no config file and no env file"
flag "--no-history" help="disable reading and writing to command history"
flag "--no-std-lib" help="start with no standard library"
flag "--config <path>" help="start with an alternate config file"
flag "--env-config <path>" help="start with an alternate environment config file"
flag "--config-home <path>" help="start with an alternate config directory"
flag "--log-level <string>" help="log level for diagnostic logs"
flag "--log-target <string>" help="set the target for the log to output"
flag "--log-file <path>" help="specify a custom log file path"
flag "--log-include <string>" var=#true help="set the Rust module prefixes to include from the log output"
flag "--log-exclude <string>" var=#true help="set the Rust module prefixes to exclude from the log output"
flag "--lsp" help="start nu's language server protocol"
flag "--dap" help="start nu's debug adapter protocol server (over stdio)"
flag "--ide-goto-def <int>" help="go to the definition of the item at the given cursor position and file"
flag "--ide-hover <int>" help="give information about the item at the given cursor position and file"
flag "--ide-complete <int>" help="list completions for the item at the given cursor position and file"
flag "--ide-check <int>" help="run a diagnostic check on the given source"
flag "--ide-ast" help="generate the ast on the given source"
flag "--experimental-options <string>" var=#true help="enable or disable experimental options"
flag "--plugin-config <path>" help="start with an alternate plugin registry file"
flag "--plugins <path>" var=#true help="plugin executable files to load, separately from the registry file"
arg "[script]" double_dash="automatic" help="the script file to run"
arg "[args]..." var=#true help="the script's own arguments"
